kground_xpos":{"unit":"px","size":0,"sizes":[]},"background_ypos":{"unit":"px","size":0,"sizes":[]},"background_attachment":"","background_repeat":"","background_size":"","background_bg_width":{"unit":"%","size":100,"sizes":[]},"background_video_link":"","background_video_start":"","background_video_end":"","background_play_once":"","background_play_on_mobile":"","background_privacy_mode":"","background_video_fallback":{"url":"","id":"","size":""},"background_slideshow_gallery":[],"background_slideshow_loop":"yes","background_slideshow_slide_duration":5000,"background_slideshow_slide_transition":"fade","background_slideshow_transition_duration":500,"background_slideshow_background_size":"","background_slideshow_background_position":"","background_slideshow_lazyload":"","background_slideshow_ken_burns":"","background_slideshow_ken_burns_zoom_direction":"in","custom_css":"","scroll_snap":"","scroll_snap_position":"","scroll_snap_padding":{"unit":"px","size":"","sizes":[]},"force_stop":""},"elements":[{"id":"4b111867","elType":"container","settings":[],"elements":[{"id":"55130a0f","elType":"widget","settings":{"editor":"<p style=\"font-weight: 400\">KBK Instrumentasi mempelajari fenomena yang dijumpai pada proses rekayasa, mengungkapkan dan menjelaskan mekanisme terjadinya fenomena tersebut secara ilmiah dan terukur, serta merancang sistem yang memanfaatkanfenomena tersebut untuk keperluan kesejahteraan manusia. Bidang instrumentasi mengembangkan di antaranya sisteminstrumentasi untuk lingkungan berbahaya, otomasi proses, sistem cerdas dan tertanam, sistem manajemen baterai, dan instrumentasi untuk lingkungan terbangun berkelanjutan.</p>\r\n\r\n<h3 style=\"font-weight: 400\"><strong>Koordinator KBK </strong><strong>Instrumentasi</strong>:</h3>\r\n<p style=\"font-weight: 400\">Prof. Dr. Ir. Faridah, S.T., M.Sc., IPU., ASEAN Eng.</p>\r\n\r\n<h3 style=\"font-weight: 400\"><strong>Anggota KBK </strong><strong>Instrumentasi</strong><strong>:</strong></h3>\r\n<ol>\r\n \t<li>Prof. Ir. Nazrul Effendy, S.T., M.T., Ph.D., IPM., ASEAN Eng.</li>\r\n \t<li>Dr-Ing. Ir. Awang Noor Indra Wardana, S.T., M.T., M.Sc., IPM.</li>\r\n \t<li>Nopriadi, S.T., M.Sc., Ph.D., IPM.</li>\r\n \t<li>Ir. Agus Arif, M.T.</li>\r\n \t<li>Dr.Eng. Ir. Dwi Joko Suroso, S.T., M.Eng., IPP.</li>\r\n \t<li>Yakub Fahim Luckyarno, S.T., M.Eng., Ph.D.</li>\r\n \t<li>Thomas Oka Pratama, S.T., M.Eng.</li>\r\n \t<li>Gandha Satria Adi, S.T., M.Eng.</li>\r\n</ol>\r\n<h3 style=\"font-weight: 400\"><strong>Peta Jalan Penelitian KBK Instrumentasi</strong></h3>\r\n<p style=\"font-weight: 400\">Peta jalan penelitian pada KBK instrumentasi meliputi beberapa topik penelitian sesuai yang ditunjukkan pada gambar-gambar berikut:</p>\r\n\r\n\r\n[caption id=\"attachment_15146\" align=\"aligncenter\" width=\"2560\"]<img class=\"wp-image-15146 size-full\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Picture1-1-scaled.jpg\" alt=\"Peta jalan penelitian manajemen bencana dan komunikasi\" width=\"2560\" height=\"2346\" /> Peta jalan penelitian manajemen bencana dan komunikasi[/caption]\r\n\r\n[caption id=\"attachment_15147\" align=\"alignnone\" width=\"2134\"]<img class=\"size-full wp-image-15147\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.48.00.png\" alt=\"Peta jalan penelitian rancang bangun system akuisisi data dan komunikasi data peringatan dini bencana\" width=\"2134\" height=\"1570\" /> Peta jalan penelitian rancang bangun system akuisisi data dan komunikasi data peringatan dini bencana[/caption]\r\n\r\n[caption id=\"attachment_15148\" align=\"aligncenter\" width=\"2060\"]<img class=\"wp-image-15148 size-full\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.49.34.png\" alt=\"Peta jalan penelitian power storage\" width=\"2060\" height=\"1330\" /> Peta jalan penelitian power storage[/caption]\r\n\r\n[caption id=\"attachment_15149\" align=\"alignnone\" width=\"2402\"]<img class=\"wp-image-15149 size-full\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.51.23.png\" alt=\"Peta jalan penelitian inovasi building management system (BMS)\" width=\"2402\" height=\"1392\" /> Peta jalan penelitian inovasi building management system (BMS)[/caption]\r\n\r\n[caption id=\"attachment_15150\" align=\"alignnone\" width=\"2234\"]<img class=\"size-full wp-image-15150\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.56.09.png\" alt=\"Peta jalan penelitian soft sensor dalam BMS\" width=\"2234\" height=\"1554\" /> Peta jalan penelitian soft sensor dalam BMS[/caption]\r\n\r\n[caption id=\"attachment_15151\" align=\"alignnone\" width=\"2326\"]<img class=\"size-full wp-image-15151\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.57.01.png\" alt=\"Peta jalan penelitian modul smart switch pada bangunan hijau\" width=\"2326\" height=\"1268\" /> Peta jalan penelitian modul smart switch pada bangunan hijau[/caption]\r\n\r\n[caption id=\"attachment_15152\" align=\"alignnone\" width=\"2550\"]<img class=\"size-full wp-image-15152\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.58.57.png\" alt=\"Peta jalan penelitian otomasi proses pada industri\" width=\"2550\" height=\"1308\" /> Peta jalan penelitian otomasi proses pada industri[/caption]\r\n\r\n[caption id=\"attachment_15153\" align=\"alignnone\" width=\"2410\"]<img class=\"size-full wp-image-15153\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-10.00.08.png\" alt=\"Peta jalan penelitian prediksi besar arus sumber ion pada Siklotron 13 MeVmenggunakan machine learning\" width=\"2410\" height=\"1342\" /> Peta jalan penelitian prediksi besar arus sumber ion pada Siklotron 13 MeV menggunakan machine learning[/caption]\r\n\r\n[caption id=\"attachment_15154\" align=\"alignnone\" width=\"2408\"]<img class=\"size-full wp-image-15154\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-10.01.39.png\" alt=\"Peta jalan penelitian system identifikasi objek berbahan logam menggunakan machine learning\" width=\"2408\" height=\"1402\" /> Peta jalan penelitian system identifikasi objek berbahan logam menggunakan machine learning[/caption]\r\n\r\n[caption id=\"attachment_15155\" align=\"alignnone\" width=\"2496\"]<img class=\"size-full wp-image-15155\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-10.03.32.png\" alt=\"Peta jalan penelitian pengendalian hama tikus di Perkebunan kelapa sawit menggunakan machine learning\" width=\"2496\" height=\"1376\" /> Peta jalan penelitian pengendalian hama tikus di Perkebunan kelapa sawit menggunakan machine learning[/caption]\r\n\r\n[caption id=\"attachment_15156\" align=\"alignnone\" width=\"2412\"]<img class=\"size-full wp-image-15156\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-10.04.08.png\" alt=\"Peta jalan penelitian optimasi system diagnosis tumor otak dari citra MRI\" width=\"2412\" height=\"1260\" /> Peta jalan penelitian optimasi system diagnosis tumor otak dari citra MRI[/caption]\r\n\r\n[caption id=\"attachment_15157\" align=\"aligncenter\" width=\"2408\"]<img class=\"wp-image-15157 size-full\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-10.04.46.png\" alt=\"Peta jalan penelitian klasifikasi penyakit glaucoma\" width=\"2408\" height=\"1356\" /> Peta jalan penelitian klasifikasi penyakit glaucoma[/caption]"},"elements":[],"widgetType":"text-editor","htmlCache":"\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-text-editor elementor-clearfix elementor-inline-editing\" data-elementor-setting-key=\"editor\" data-elementor-inline-editing-toolbar=\"advanced\">\n\t\t\t\t<p style=\"font-weight: 400\">KBK Instrumentasi mempelajari fenomena yang dijumpai pada proses rekayasa, mengungkapkan dan menjelaskan mekanisme terjadinya fenomena tersebut secara ilmiah dan terukur, serta merancang sistem yang memanfaatkanfenomena tersebut untuk keperluan kesejahteraan manusia. Bidang instrumentasi mengembangkan di antaranya sisteminstrumentasi untuk lingkungan berbahaya, otomasi proses, sistem cerdas dan tertanam, sistem manajemen baterai, dan instrumentasi untuk lingkungan terbangun berkelanjutan.</p>\r\n\r\n<h3 style=\"font-weight: 400\"><strong>Koordinator KBK </strong><strong>Instrumentasi</strong>:</h3>\r\n<p style=\"font-weight: 400\">Prof. Dr. Ir. Faridah, S.T., M.Sc., IPU., ASEAN Eng.</p>\r\n\r\n<h3 style=\"font-weight: 400\"><strong>Anggota KBK </strong><strong>Instrumentasi</strong><strong>:</strong></h3>\r\n<ol>\r\n \t<li>Prof. Ir. Nazrul Effendy, S.T., M.T., Ph.D., IPM., ASEAN Eng.</li>\r\n \t<li>Dr-Ing. Ir. Awang Noor Indra Wardana, S.T., M.T., M.Sc., IPM.</li>\r\n \t<li>Nopriadi, S.T., M.Sc., Ph.D., IPM.</li>\r\n \t<li>Ir. Agus Arif, M.T.</li>\r\n \t<li>Dr.Eng. Ir. Dwi Joko Suroso, S.T., M.Eng., IPP.</li>\r\n \t<li>Yakub Fahim Luckyarno, S.T., M.Eng., Ph.D.</li>\r\n \t<li>Thomas Oka Pratama, S.T., M.Eng.</li>\r\n \t<li>Gandha Satria Adi, S.T., M.Eng.</li>\r\n</ol>\r\n<h3 style=\"font-weight: 400\"><strong>Peta Jalan Penelitian KBK Instrumentasi</strong></h3>\r\n<p style=\"font-weight: 400\">Peta jalan penelitian pada KBK instrumentasi meliputi beberapa topik penelitian sesuai yang ditunjukkan pada gambar-gambar berikut:</p>\r\n\r\n\r\n<figure id=\"attachment_15146\" aria-describedby=\"caption-attachment-15146\" style=\"width: 2560px\" class=\"wp-caption aligncenter\"><img class=\"wp-image-15146 size-full\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Picture1-1-scaled.jpg\" alt=\"Peta jalan penelitian manajemen bencana dan komunikasi\" width=\"2560\" height=\"2346\" /><figcaption id=\"caption-attachment-15146\" class=\"wp-caption-text\">Peta jalan penelitian manajemen bencana dan komunikasi</figcap