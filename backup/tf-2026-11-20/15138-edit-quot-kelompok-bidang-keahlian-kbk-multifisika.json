und_xpos":{"unit":"px","size":0,"sizes":[]},"background_ypos":{"unit":"px","size":0,"sizes":[]},"background_attachment":"","background_repeat":"","background_size":"","background_bg_width":{"unit":"%","size":100,"sizes":[]},"background_video_link":"","background_video_start":"","background_video_end":"","background_play_once":"","background_play_on_mobile":"","background_privacy_mode":"","background_video_fallback":{"url":"","id":"","size":""},"background_slideshow_gallery":[],"background_slideshow_loop":"yes","background_slideshow_slide_duration":5000,"background_slideshow_slide_transition":"fade","background_slideshow_transition_duration":500,"background_slideshow_background_size":"","background_slideshow_background_position":"","background_slideshow_lazyload":"","background_slideshow_ken_burns":"","background_slideshow_ken_burns_zoom_direction":"in","custom_css":"","scroll_snap":"","scroll_snap_position":"","scroll_snap_padding":{"unit":"px","size":"","sizes":[]},"force_stop":""},"elements":[{"id":"32b5ff5d","elType":"container","settings":[],"elements":[{"id":"b87ed2b","elType":"widget","settings":{"editor":"<p style=\"font-weight: 400\">KBK Multifisika melakukan studi, penelitian dan pengembangan teknologi yang melibatkan interaksi antara beberapafenomena fisika yang beragam, baik itu mekanika, termodinamika, listrik, elektromagnetik, optika, akustik dan lain sebagainya. Bidang yang dikembangkan meliputi rekayasa fisika bangunan dan rekayasa multifisika multiskala dari bidang rekayasa material cerdas dan fisika konservasi</p>\r\n\r\n<h3 style=\"font-weight: 400\"><strong>Koordinator KBK </strong><strong>Multifisika</strong>:</h3>\r\n<p style=\"font-weight: 400\">Ir. Sentagi Sesotya Utami, S.T., M.Sc., Ph.D., IPU.</p>\r\n\r\n<h3 style=\"font-weight: 400\"><strong>Anggota KBK </strong><strong>Multifisika</strong><strong>:</strong></h3>\r\n<ol>\r\n \t<li>Dr. Eng. Mohammad Kholid Ridwan, S.T., M.Sc., IPU.</li>\r\n \t<li>Dr. Gea Oswah Fatah Parikesit, S.T., M.Sc.</li>\r\n \t<li>Ir. Nur Abdillah Siddiq, S.T., IPP.</li>\r\n \t<li>Ferdiansjah, S.T., M.Eng.Sc.</li>\r\n \t<li>Lucyana Dwi Larasati, S.T., M.S.</li>\r\n</ol>\r\n<h3 style=\"font-weight: 400\"><strong>Peta Jalan Penelitian KBK Multifisika</strong></h3>\r\n<span style=\"font-weight: 400\">P</span><span style=\"font-weight: 400\">et</span><span style=\"font-weight: 400\">a jalan penelitian KBK Multifisika terdiri dari beberapa ontology yaitu ontology bidang material, ontology fisika konservasi , dan ontology fisika bangunan. Kegiatan penelitian pada KBK Multifisika secara garis besar dimulai dengan kajian dan karakterisasi material, pengujian skala laboratorium, fabrikasi,pengembangan dan pengujian di lapangan, serta integrasi pada bangunan dan kebutuhan industri.</span>\r\n\r\n[caption id=\"attachment_15140\" align=\"aligncenter\" width=\"2446\"]<img class=\"size-full wp-image-15140\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.25.04.png\" alt=\"Peta jalan penelitian KBK Multifisika ontology material\" width=\"2446\" height=\"1452\" /> Gambar 1. Peta jalan penelitian KBK Multifisika ontology material[/caption]\r\n\r\n[caption id=\"attachment_15141\" align=\"aligncenter\" width=\"2538\"]<img class=\"size-full wp-image-15141\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.26.30.png\" alt=\"Peta jalan penelitian KBK Multifisika ontology Fisika Konservasi\" width=\"2538\" height=\"1184\" /> Gambar 2. Peta jalan penelitian KBK Multifisika ontology Fisika Konservasi[/caption]\r\n\r\n[caption id=\"attachment_15142\" align=\"aligncenter\" width=\"2560\"]<img class=\"size-full wp-image-15142\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Picture1-scaled.jpg\" alt=\"Peta jalan penelitian KBK Multifisika-Ontology Fisika Bangunan\" width=\"2560\" height=\"2560\" /> Gambar 3. Peta jalan penelitian KBK Multifisika-Ontology Fisika Bangunan[/caption]"},"elements":[],"widgetType":"text-editor","htmlCache":"\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-text-editor elementor-clearfix elementor-inline-editing\" data-elementor-setting-key=\"editor\" data-elementor-inline-editing-toolbar=\"advanced\">\n\t\t\t\t<p style=\"font-weight: 400\">KBK Multifisika melakukan studi, penelitian dan pengembangan teknologi yang melibatkan interaksi antara beberapafenomena fisika yang beragam, baik itu mekanika, termodinamika, listrik, elektromagnetik, optika, akustik dan lain sebagainya. Bidang yang dikembangkan meliputi rekayasa fisika bangunan dan rekayasa multifisika multiskala dari bidang rekayasa material cerdas dan fisika konservasi</p>\r\n\r\n<h3 style=\"font-weight: 400\"><strong>Koordinator KBK </strong><strong>Multifisika</strong>:</h3>\r\n<p style=\"font-weight: 400\">Ir. Sentagi Sesotya Utami, S.T., M.Sc., Ph.D., IPU.</p>\r\n\r\n<h3 style=\"font-weight: 400\"><strong>Anggota KBK </strong><strong>Multifisika</strong><strong>:</strong></h3>\r\n<ol>\r\n \t<li>Dr. Eng. Mohammad Kholid Ridwan, S.T., M.Sc., IPU.</li>\r\n \t<li>Dr. Gea Oswah Fatah Parikesit, S.T., M.Sc.</li>\r\n \t<li>Ir. Nur Abdillah Siddiq, S.T., IPP.</li>\r\n \t<li>Ferdiansjah, S.T., M.Eng.Sc.</li>\r\n \t<li>Lucyana Dwi Larasati, S.T., M.S.</li>\r\n</ol>\r\n<h3 style=\"font-weight: 400\"><strong>Peta Jalan Penelitian KBK Multifisika</strong></h3>\r\n<span style=\"font-weight: 400\">P</span><span style=\"font-weight: 400\">et</span><span style=\"font-weight: 400\">a jalan penelitian KBK Multifisika terdiri dari beberapa ontology yaitu ontology bidang material, ontology fisika konservasi , dan ontology fisika bangunan. Kegiatan penelitian pada KBK Multifisika secara garis besar dimulai dengan kajian dan karakterisasi material, pengujian skala laboratorium, fabrikasi,pengembangan dan pengujian di lapangan, serta integrasi pada bangunan dan kebutuhan industri.</span>\r\n\r\n<figure id=\"attachment_15140\" aria-describedby=\"caption-attachment-15140\" style=\"width: 2446px\" class=\"wp-caption aligncenter\"><img class=\"size-full wp-image-15140\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.25.04.png\" alt=\"Peta jalan penelitian KBK Multifisika ontology material\" width=\"2446\" height=\"1452\" /><figcaption id=\"caption-attachment-15140\" class=\"wp-caption-text\">Gambar 1. Peta jalan penelitian KBK Multifisika ontology material</figcaption></figure>\r\n\r\n<figure id=\"attachment_15141\" aria-describedby=\"caption-attachment-15141\" style=\"width: 2538px\" class=\"wp-caption aligncenter\"><img class=\"size-full wp-image-15141\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Screenshot-2025-04-10-at-09.26.30.png\" alt=\"Peta jalan penelitian KBK Multifisika ontology Fisika Konservasi\" width=\"2538\" height=\"1184\" /><figcaption id=\"caption-attachment-15141\" class=\"wp-caption-text\">Gambar 2. Peta jalan penelitian KBK Multifisika ontology Fisika Konservasi</figcaption></figure>\r\n\r\n<figure id=\"attachment_15142\" aria-describedby=\"caption-attachment-15142\" style=\"width: 2560px\" class=\"wp-caption aligncenter\"><img class=\"size-full wp-image-15142\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2025/04/Picture1-scaled.jpg\" alt=\"Peta jalan penelitian KBK Multifisika-Ontology Fisika Bangunan\" width=\"2560\" height=\"2560\" /><figcaption id=\"caption-attachment-15142\" class=\"wp-caption-text\">Gambar 3. Peta jalan penelitian KBK Multifisika-Ontology Fisika Bangunan</figcaption></figure>\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t"}],"isInner":false}]}