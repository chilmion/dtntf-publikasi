size":0,"sizes":[]},"background_ypos":{"unit":"px","size":0,"sizes":[]},"background_attachment":"","background_repeat":"","background_size":"","background_bg_width":{"unit":"%","size":100,"sizes":[]},"background_video_link":"","background_video_start":"","background_video_end":"","background_play_once":"","background_play_on_mobile":"","background_privacy_mode":"","background_video_fallback":{"url":"","id":"","size":""},"background_slideshow_gallery":[],"background_slideshow_loop":"yes","background_slideshow_slide_duration":5000,"background_slideshow_slide_transition":"fade","background_slideshow_transition_duration":500,"background_slideshow_background_size":"","background_slideshow_background_position":"","background_slideshow_lazyload":"","background_slideshow_ken_burns":"","background_slideshow_ken_burns_zoom_direction":"in","custom_css":"","scroll_snap":"","scroll_snap_position":"","scroll_snap_padding":{"unit":"px","size":"","sizes":[]},"force_stop":""},"elements":[{"id":"783a5bc2","elType":"container","settings":[],"elements":[{"id":"78a5756c","elType":"widget","settings":{"editor":"<h1>Deskripsi</h1>\r\nLaboratorium Energi Terbarukan (ET) membidangi pengembangan sistem energi baru dan terbarukan serta sistem konservasi energi. Cakupan utamanya meliputi sistem pengubah, penyimpan dan penghemat penggunaan energi, serta sistem penyedia bahan bakar alternatif yang lebih ramah lingkungan daripada bahan bakar fosil.\r\n\r\n&nbsp;\r\n<h1>Aktivitas</h1>\r\n<h3>Pendidikan</h3>\r\nKegiatan pendidikan utama yang dilakukan di laboratorium ET adalah Praktikum Energi. Selain praktikum, laboratorium juga mendukung skema sinergi pengajaran untuk mengembangkan <em>technopreneurship </em>di bidang energi terbarukan dan efisiensi energi.\r\n<h3>Penelitian</h3>\r\nRiset yang dilaksanakan berkaitan dengan sistem konservasi energi, sistem pemantauan energi, dan penggunaan energi terbarukan <em>(solar system, wind system).</em>\r\n<h3>Pengabdian Masyarakat</h3>\r\nLayanan masyarakat yang dilakukan berupa:\r\n<ul>\r\n \t<li>Program pengembangan sistem penyediaan air bersih berbasis energi terbarukan.</li>\r\n \t<li>Studi potensi energi terbarukan.</li>\r\n \t<li>Workshop sistem energi terbarukan.</li>\r\n \t<li>Kajian konservasi energi di industri dan pada bangunan.</li>\r\n \t<li>Kajian keselamatan sistem industri.</li>\r\n</ul>\r\n<h1>Fasilitas dan Peralatan Utama</h1>\r\n<ul>\r\n \t<li>Sistem pengujian karakteristik turbin angin dan air.</li>\r\n \t<li>Sistem pengujian karakteristik panel surya.</li>\r\n \t<li>Peralatan pengukuran untuk konservasi energi pada bangunan.</li>\r\n \t<li>Jaringan komputasi untuk pemodelan sistem energi.</li>\r\n</ul>\r\n<h1>Staf</h1>\r\n<strong>Kepala laboratorium</strong>: Ahmad Agus Setiawan, S.T., M.Sc., Ph.D.\r\n\r\n<strong>Laboran</strong>: Budiyono\r\n\r\n&nbsp;\r\n<table>\r\n<tbody>\r\n<tr>\r\n<th>Nama Dosen Peneliti</th>\r\n<th>Bidang Keahlian</th>\r\n</tr>\r\n<tr>\r\n<td>Ahmad Agus Setiawan, S.T., M.Sc., Ph.D.</td>\r\n<td>Energi Terbarukan untuk Pengembangan Berkelanjutan</td>\r\n</tr>\r\n<tr>\r\n<td>Ir. Nunung Prabaningrum, M.T., Ph.D.</td>\r\n<td>Energi Terbarukan biomasa</td>\r\n</tr>\r\n<tr>\r\n<td>Dr. Ir. Andang Widi Harto, M.T.</td>\r\n<td>Energi Nuklir</td>\r\n</tr>\r\n<tr>\r\n<td>Ari Bimo Prakoso, S.T., Ph.D.</td>\r\n<td>Energi Surya</td>\r\n</tr>\r\n<tr>\r\n<td>Ayodya Pradipta Tenggara, S.T., M.Sc., Ph.D.</td>\r\n<td>Energi Terbarukan untuk Pengembangan Berkelanjutan</td>\r\n</tr>\r\n<tr>\r\n<td>Fadli Kasim, S.T., M.Sc.</td>\r\n<td>Energi Terbarukan untuk Pengembangan Berkelanjutan</td>\r\n</tr>\r\n<tr>\r\n<td>Ferdiansjah, S.T., M.Eng.Sc.</td>\r\n<td>Energi Surya</td>\r\n</tr>\r\n<tr>\r\n<td>Ir. Kutut Suryopratomo, M.T., M.Sc.</td>\r\n<td>Konversi Energi, Energi Terbarukan</td>\r\n</tr>\r\n<tr>\r\n<td>Dr. Eng. Mohammad Kholid Ridwan, S.T., M.Sc.</td>\r\n<td>Energi untuk Lingkungan Perkotaan</td>\r\n</tr>\r\n<tr>\r\n<td>Dr. Rachmawan Budiarto, S.T., M.T.</td>\r\n<td>Kebijakan Energi, Diversifikasi Energi, Sistem Energi Terbarukan</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<h1>Dokumentasi</h1>\r\n<a href=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2026/10/POS-Surat-Bebas-Fasilitas-Laboratorium-DTNTF-Final.pdf\">POS Bebas Laboratorium</a>\r\n<a href=\"https://drive.google.com/file/d/1iizbsVn90hizcJwGiCIOhi9oK7QDLxrr/view?usp=sharing\">POS Peminjaman Alat Laboratorium</a>\r\n<a href=\"https://drive.google.com/file/d/1UqyHy7WyIhOqGdPWxJAfD9Vz04VwzDmq/view?usp=sharing\">POS Pelaksanaan Praktikum</a>\r\n<a href=\"https://drive.google.com/file/d/1junr33wUFyOv_XhqPYEHp1mP-ktaXJ8j/view?usp=sharing\">POS Penggunaan Ruang dan Fasilitas Laboratorium</a>\r\n<a href=\"https://drive.google.com/file/d/1cIRV8-PJn8SGS36kKkuA5peaHhvzNoKB/view?usp=sharing\">POS Kunjungan Laboratorium</a>"},"elements":[],"widgetType":"text-editor","htmlCache":"\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-text-editor elementor-clearfix elementor-inline-editing\" data-elementor-setting-key=\"editor\" data-elementor-inline-editing-toolbar=\"advanced\">\n\t\t\t\t<h1>Deskripsi</h1>\r\nLaboratorium Energi Terbarukan (ET) membidangi pengembangan sistem energi baru dan terbarukan serta sistem konservasi energi. Cakupan utamanya meliputi sistem pengubah, penyimpan dan penghemat penggunaan energi, serta sistem penyedia bahan bakar alternatif yang lebih ramah lingkungan daripada bahan bakar fosil.\r\n\r\n&nbsp;\r\n<h1>Aktivitas</h1>\r\n<h3>Pendidikan</h3>\r\nKegiatan pendidikan utama yang dilakukan di laboratorium ET adalah Praktikum Energi. Selain praktikum, laboratorium juga mendukung skema sinergi pengajaran untuk mengembangkan <em>technopreneurship </em>di bidang energi terbarukan dan efisiensi energi.\r\n<h3>Penelitian</h3>\r\nRiset yang dilaksanakan berkaitan dengan sistem konservasi energi, sistem pemantauan energi, dan penggunaan energi terbarukan <em>(solar system, wind system).</em>\r\n<h3>Pengabdian Masyarakat</h3>\r\nLayanan masyarakat yang dilakukan berupa:\r\n<ul>\r\n \t<li>Program pengembangan sistem penyediaan air bersih berbasis energi terbarukan.</li>\r\n \t<li>Studi potensi energi terbarukan.</li>\r\n \t<li>Workshop sistem energi terbarukan.</li>\r\n \t<li>Kajian konservasi energi di industri dan pada bangunan.</li>\r\n \t<li>Kajian keselamatan sistem industri.</li>\r\n</ul>\r\n<h1>Fasilitas dan Peralatan Utama</h1>\r\n<ul>\r\n \t<li>Sistem pengujian karakteristik turbin angin dan air.</li>\r\n \t<li>Sistem pengujian karakteristik panel surya.</li>\r\n \t<li>Peralatan pengukuran untuk konservasi energi pada bangunan.</li>\r\n \t<li>Jaringan komputasi untuk pemodelan sistem energi.</li>\r\n</ul>\r\n<h1>Staf</h1>\r\n<strong>Kepala laboratorium</strong>: Ahmad Agus Setiawan, S.T., M.Sc., Ph.D.\r\n\r\n<strong>Laboran</strong>: Budiyono\r\n\r\n&nbsp;\r\n<table>\r\n<tbody>\r\n<tr>\r\n<th>Nama Dosen Peneliti</th>\r\n<th>Bidang Keahlian</th>\r\n</tr>\r\n<tr>\r\n<td>Ahmad Agus Setiawan, S.T., M.Sc., Ph.D.</td>\r\n<td>Energi Terbarukan untuk Pengembangan Berkelanjutan</td>\r\n</tr>\r\n<tr>\r\n<td>Ir. Nunung Prabaningrum, M.T., Ph.D.</td>\r\n<td>Energi Terbarukan biomasa</td>\r\n</tr>\r\n<tr>\r\n<td>Dr. Ir. Andang Widi Harto, M.T.</td>\r\n<td>Energi Nuklir</td>\r\n</tr>\r\n<tr>\r\n<td>Ari Bimo Prakoso, S.T., Ph.D.</td>\r\n<td>Energi Surya</td>\r\n</tr>\r\n<tr>\r\n<td>Ayodya Pradipta Tenggara, S.T., M.Sc., Ph.D.</td>\r\n<td>Energi Terbarukan untuk Pengembangan Berkelanjutan</td>\r\n</tr>\r\n<tr>\r\n<td>Fadli Kasim, S.T., M.Sc.</td>\r\n<td>Energi Terbarukan untuk Pengembangan Berkelanjutan</td>\r\n</tr>\r\n<tr>\r\n<td>Ferdiansjah, S.T., M.Eng.Sc.</td>\r\n<td>Energi Surya</td>\r\n</tr>\r\n<tr>\r\n<td>Ir. Kutut Suryopratomo, M.T., M.Sc.</td>\r\n<td>Konversi Energi, Energi Terbarukan</td>\r\n</tr>\r\n<tr>\r\n<td>Dr. Eng. Mohammad Kholid Ridwan, S.T., M.Sc.</td>\r\n<td>Energi untuk Lingkungan Perkotaan</td>\r\n</tr>\r\n<tr>\r\n<td>Dr. Rachmawan Budiarto, S.T., M.T.</td>\r\n<td>Kebijakan Energi, Diversifikasi Energi, Sistem Energi Terbarukan</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<h1>Dokumentasi</h1>\r\n<a href=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2026/10/POS-Surat-Bebas-Fasilitas-Laboratorium-DTNTF-Final.pdf\">POS Bebas Laboratorium</a>\r\n<a href=\"https://drive.google.com/file/d/1iizbsVn90hizcJwGiCIOhi9oK7QDLxrr/view?usp=sharing\">POS Peminjaman Alat Laboratorium</a>\r\n<a href=\"https://drive.google.com/file/d/1UqyHy7WyIhOqGdPWxJAfD9Vz04VwzDmq/view?usp=sharing\">POS Pelaksanaan Praktikum</a>\r\n<a href=\"https://drive.google.com/file/d/1junr33wUFyOv_XhqPYEHp1mP-ktaXJ8j/view?usp=sharing\">POS Penggunaan Ruang dan Fasilitas Laboratorium</a>\r\n<a href=\"https://drive.google.com/file/d/1cIRV8-PJn8SGS36kKkuA5peaHhvzNoKB/view?usp=sharing\">POS Kunjungan Laboratorium</a>\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t"}],"isInner":false}]}