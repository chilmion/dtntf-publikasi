os":{"unit":"px","size":0,"sizes":[]},"background_ypos":{"unit":"px","size":0,"sizes":[]},"background_attachment":"","background_repeat":"","background_size":"","background_bg_width":{"unit":"%","size":100,"sizes":[]},"background_video_link":"","background_video_start":"","background_video_end":"","background_play_once":"","background_play_on_mobile":"","background_privacy_mode":"","background_video_fallback":{"url":"","id":"","size":""},"background_slideshow_gallery":[],"background_slideshow_loop":"yes","background_slideshow_slide_duration":5000,"background_slideshow_slide_transition":"fade","background_slideshow_transition_duration":500,"background_slideshow_background_size":"","background_slideshow_background_position":"","background_slideshow_lazyload":"","background_slideshow_ken_burns":"","background_slideshow_ken_burns_zoom_direction":"in","custom_css":"","scroll_snap":"","scroll_snap_position":"","scroll_snap_padding":{"unit":"px","size":"","sizes":[]},"force_stop":""},"elements":[{"id":"1106cda2","elType":"container","settings":[],"elements":[{"id":"36b610ea","elType":"widget","settings":{"editor":"<p style=\"text-align: justify\"><img class=\"wp-image-8871 size-full alignleft\" style=\"float: left\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2018/11/Cementation.jpg\" alt=\"\" width=\"267\" height=\"189\" />Keberhasilan dalam pengelolaan limbah radioaktif dipercaya merupakan kunci keberhasilan pengembangan teknologi nuklir di suatu negara. Untuk itu, kelompok penelitian ini fokus pada pengembangan metode, bahan-bahan yang mampu digunakan dalam pengelolaan limbah radioaktif, keamanan dan safeguards nuklir dalam  pengelolaan limbah.</p>\r\n<p style=\"text-align: justify\"><img class=\"wp-image-871 alignright\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2018/02/Limbah-300x300.jpg\" alt=\"\" width=\"220\" height=\"220\" />Untuk mendapatkan umpan balik bagi hasil-hasil riset yang didapatkan, para peneliti dalam kelompok ini secara aktif turut serta dalam forum-forum pertemuan ilmiah baik yang berskala nasional maupun internasional. Kelompok ini juga berperan sebagai pendamping maupun nara sumber dalam pengembangan pengelolaan limbah radioaktif di daerah maupun nasional yang dilakukan oleh Pemda, BATAN dan BAPETEN.</p>\r\n\r\n<table style=\"height: 2397px\" width=\"811\">\r\n<tbody>\r\n<tr valign=\"top\">\r\n<td><strong>Riset:</strong>\r\n<ul>\r\n \t<li>Desain <em>Multi Purpose Container</em> (Riset Unggulan Kemitraan,  1999).</li>\r\n \t<li>Desain kontainer sumber teleterapi.</li>\r\n \t<li>Pengelolaan limbah reaktor maju (MSR, PLTN Terapung, AP1000).</li>\r\n \t<li>Studi pemisahan Molibdenum dengan Metode Elektrolisis.</li>\r\n \t<li>Pembuatan Keramik Borosilikat dari berbagai bahan (abu Gunung Merapi, gelas, zeolit dll) untuk imobilisasi limbah radioaktif.</li>\r\n \t<li>Studi pemanfaatan berbagai macam bahan (abu sekam padi, abu merapi, abu layang PLTU, <em>sand blast</em> dll) sebagai bahan pozolan dalam proses sementasi limbah radioaktif.</li>\r\n \t<li>Studi pengungkung limbah radioaktif dalam pembuangan di laut.</li>\r\n \t<li>Studi keselamatan dan keamanan tempat penyimpanan limbah radioaktif di laut dalam.</li>\r\n \t<li>Studi penggunaan serat alam (bambu, serat kelapa dll) dalam sementasi limbah radioaktif.</li>\r\n \t<li>Studi pemanfaatan bahan alam sebagai bahan filter keramik.</li>\r\n \t<li>Studi pemanfaatan Metode Elektro-Koagulasi untuk mengolah limbah radioaktif cair.</li>\r\n \t<li>Studi keamanan transportasi limbah.</li>\r\n \t<li>Studi kemampuan penjerapan beberapa bahan alam (karbon aktif, abu sekam padi dll).</li>\r\n</ul>\r\n<img class=\"alignnone wp-image-245 size-medium\" style=\"float: left\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/PatenPengelolaanLimbahRadioaktif-218x300.jpg\" alt=\"PatenPengelolaanLimbahRadioaktif\" width=\"218\" height=\"300\" />\r\n\r\n<strong>Paten:</strong>\r\n\r\nMetode Pemadatan Limbah Beracun dan Berbahaya dengan Semen dan Serat Alami, Sertifikat Paten Republik Indonesia no ID P0030650, 12 April 2012.<a class=\"modal\" style=\"line-height: 1.5\" href=\"http://web06.opencloud.dssdi.ugm.ac.id/wp-content/uploads/sites/7/2013/06/PatenPengelolaanLimbahRadioaktif.jpg\" rel=\"{handler: 'iframe', size:{x:820, y:600}}\"><span class=\"modal\" style=\"line-height: 1.5\">\r\n</span></a>\r\n\r\n<strong><span class=\"modal\" style=\"line-height: 1.5\"><span class=\"modal\" style=\"line-height: 1.5\">Mitra:</span></span></strong>\r\n<ul>\r\n \t<li>Pusat Teknologi Limbah Radioaktif-BATAN.</li>\r\n \t<li>BAPETEN</li>\r\n \t<li>PT. Inuki (Persero).</li>\r\n \t<li>PT. Holcim Indonesia.</li>\r\n</ul>\r\n<strong>Peneliti Utama</strong><strong> :</strong>\r\n<ul>\r\n \t<li>Ir. Yudi Utomo Imardjoko, M.Sc., Ph.D.</li>\r\n \t<li>Dr-Ing. Kusnanto</li>\r\n \t<li>Ir. Nunung Prabaningrum, MT., Ph.D.</li>\r\n \t<li>Ferdiansjah, ST., M.Eng. Sc.</li>\r\n \t<li>Ir. Mondjo, M.Si.</li>\r\n \t<li>Ir. Susetyo Hario Putero, M.Eng.</li>\r\n \t<li>Ir. Anung Muharini, MT.</li>\r\n \t<li>Widya Rosita, ST., MT.</li>\r\n</ul>\r\n<em><strong>Contact Person :</strong></em>\r\n\r\nSusetyo Hario Putero\r\n\r\nsusetyo@ugm.ac.id\r\n\r\n<img class=\"wp-image-259 alignleft\" style=\"float: left\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/HLRWM2-240x300.jpg\" alt=\"HLRWM2\" width=\"130\" height=\"163\" /><img class=\"wp-image-258 alignright\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Riset_Ita-268x300.png\" alt=\"Riset Ita\" width=\"147\" height=\"164\" /><img class=\"wp-image-1194 aligncenter\" style=\"font-family: inherit;font-size: inherit\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2018/03/JEAS-e1624089401816.jpg\" alt=\"\" width=\"114\" height=\"159\" /></td>\r\n<td style=\"width: 350px\"><img class=\"wp-image-247 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Contour_plot_penyerap-1-300x200.jpg\" alt=\"Contour plot penyerap\" width=\"239\" height=\"159\" />\r\n\r\n<img class=\"wp-image-249 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/XRD_RHA-Resize-1-219x300.jpg\" alt=\"XRD RHA-Resize\" width=\"267\" height=\"366\" />\r\n\r\n<img class=\"wp-image-250 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Gelas_Borosilikat-e1624089382624.jpg\" alt=\"Gelas Borosilikat\" width=\"191\" height=\"207\" />\r\n\r\n<img class=\"wp-image-252 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/PO20090304_0000-1-300x200.jpg\" alt=\"PO20090304 0000\" width=\"269\" height=\"179\" /><img class=\"wp-image-253 aligncenter\" style=\"font-family: inherit;font-size: inherit\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Sementasi-Edit-300x161.jpg\" alt=\"Sementasi-Edit\" width=\"266\" height=\"143\" />\r\n\r\n<img class=\" wp-image-255 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Elektrokoagulasi2-300x210.jpg\" alt=\"\" width=\"281\" height=\"197\" /></td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n&nbsp;"},"elements":[],"widgetType":"text-editor","htmlCache":"\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t<div class=\"elementor-text-editor elementor-clearfix elementor-inline-editing\" data-elementor-setting-key=\"editor\" data-elementor-inline-editing-toolbar=\"advanced\">\n\t\t\t\t<p style=\"text-align: justify\"><img class=\"wp-image-8871 size-full alignleft\" style=\"float: left\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2018/11/Cementation.jpg\" alt=\"\" width=\"267\" height=\"189\" />Keberhasilan dalam pengelolaan limbah radioaktif dipercaya merupakan kunci keberhasilan pengembangan teknologi nuklir di suatu negara. Untuk itu, kelompok penelitian ini fokus pada pengembangan metode, bahan-bahan yang mampu digunakan dalam pengelolaan limbah radioaktif, keamanan dan safeguards nuklir dalam  pengelolaan limbah.</p>\r\n<p style=\"text-align: justify\"><img class=\"wp-image-871 alignright\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2018/02/Limbah-300x300.jpg\" alt=\"\" width=\"220\" height=\"220\" />Untuk mendapatkan umpan balik bagi hasil-hasil riset yang didapatkan, para peneliti dalam kelompok ini secara aktif turut serta dalam forum-forum pertemuan ilmiah baik yang berskala nasional maupun internasional. Kelompok ini juga berperan sebagai pendamping maupun nara sumber dalam pengembangan pengelolaan limbah radioaktif di daerah maupun nasional yang dilakukan oleh Pemda, BATAN dan BAPETEN.</p>\r\n\r\n<table style=\"height: 2397px\" width=\"811\">\r\n<tbody>\r\n<tr valign=\"top\">\r\n<td><strong>Riset:</strong>\r\n<ul>\r\n \t<li>Desain <em>Multi Purpose Container</em> (Riset Unggulan Kemitraan,  1999).</li>\r\n \t<li>Desain kontainer sumber teleterapi.</li>\r\n \t<li>Pengelolaan limbah reaktor maju (MSR, PLTN Terapung, AP1000).</li>\r\n \t<li>Studi pemisahan Molibdenum dengan Metode Elektrolisis.</li>\r\n \t<li>Pembuatan Keramik Borosilikat dari berbagai bahan (abu Gunung Merapi, gelas, zeolit dll) untuk imobilisasi limbah radioaktif.</li>\r\n \t<li>Studi pemanfaatan berbagai macam bahan (abu sekam padi, abu merapi, abu layang PLTU, <em>sand blast</em> dll) sebagai bahan pozolan dalam proses sementasi limbah radioaktif.</li>\r\n \t<li>Studi pengungkung limbah radioaktif dalam pembuangan di laut.</li>\r\n \t<li>Studi keselamatan dan keamanan tempat penyimpanan limbah radioaktif di laut dalam.</li>\r\n \t<li>Studi penggunaan serat alam (bambu, serat kelapa dll) dalam sementasi limbah radioaktif.</li>\r\n \t<li>Studi pemanfaatan bahan alam sebagai bahan filter keramik.</li>\r\n \t<li>Studi pemanfaatan Metode Elektro-Koagulasi untuk mengolah limbah radioaktif cair.</li>\r\n \t<li>Studi keamanan transportasi limbah.</li>\r\n \t<li>Studi kemampuan penjerapan beberapa bahan alam (karbon aktif, abu sekam padi dll).</li>\r\n</ul>\r\n<img class=\"alignnone wp-image-245 size-medium\" style=\"float: left\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/PatenPengelolaanLimbahRadioaktif-218x300.jpg\" alt=\"PatenPengelolaanLimbahRadioaktif\" width=\"218\" height=\"300\" />\r\n\r\n<strong>Paten:</strong>\r\n\r\nMetode Pemadatan Limbah Beracun dan Berbahaya dengan Semen dan Serat Alami, Sertifikat Paten Republik Indonesia no ID P0030650, 12 April 2012.<a class=\"modal\" style=\"line-height: 1.5\" href=\"http://web06.opencloud.dssdi.ugm.ac.id/wp-content/uploads/sites/7/2013/06/PatenPengelolaanLimbahRadioaktif.jpg\" rel=\"{handler: 'iframe', size:{x:820, y:600}}\"><span class=\"modal\" style=\"line-height: 1.5\">\r\n</span></a>\r\n\r\n<strong><span class=\"modal\" style=\"line-height: 1.5\"><span class=\"modal\" style=\"line-height: 1.5\">Mitra:</span></span></strong>\r\n<ul>\r\n \t<li>Pusat Teknologi Limbah Radioaktif-BATAN.</li>\r\n \t<li>BAPETEN</li>\r\n \t<li>PT. Inuki (Persero).</li>\r\n \t<li>PT. Holcim Indonesia.</li>\r\n</ul>\r\n<strong>Peneliti Utama</strong><strong> :</strong>\r\n<ul>\r\n \t<li>Ir. Yudi Utomo Imardjoko, M.Sc., Ph.D.</li>\r\n \t<li>Dr-Ing. Kusnanto</li>\r\n \t<li>Ir. Nunung Prabaningrum, MT., Ph.D.</li>\r\n \t<li>Ferdiansjah, ST., M.Eng. Sc.</li>\r\n \t<li>Ir. Mondjo, M.Si.</li>\r\n \t<li>Ir. Susetyo Hario Putero, M.Eng.</li>\r\n \t<li>Ir. Anung Muharini, MT.</li>\r\n \t<li>Widya Rosita, ST., MT.</li>\r\n</ul>\r\n<em><strong>Contact Person :</strong></em>\r\n\r\nSusetyo Hario Putero\r\n\r\nsusetyo@ugm.ac.id\r\n\r\n<img class=\"wp-image-259 alignleft\" style=\"float: left\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/HLRWM2-240x300.jpg\" alt=\"HLRWM2\" width=\"130\" height=\"163\" /><img class=\"wp-image-258 alignright\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Riset_Ita-268x300.png\" alt=\"Riset Ita\" width=\"147\" height=\"164\" /><img class=\"wp-image-1194 aligncenter\" style=\"font-family: inherit;font-size: inherit\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2018/03/JEAS-e1624089401816.jpg\" alt=\"\" width=\"114\" height=\"159\" /></td>\r\n<td style=\"width: 350px\"><img class=\"wp-image-247 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Contour_plot_penyerap-1-300x200.jpg\" alt=\"Contour plot penyerap\" width=\"239\" height=\"159\" />\r\n\r\n<img class=\"wp-image-249 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/XRD_RHA-Resize-1-219x300.jpg\" alt=\"XRD RHA-Resize\" width=\"267\" height=\"366\" />\r\n\r\n<img class=\"wp-image-250 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Gelas_Borosilikat-e1624089382624.jpg\" alt=\"Gelas Borosilikat\" width=\"191\" height=\"207\" />\r\n\r\n<img class=\"wp-image-252 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/PO20090304_0000-1-300x200.jpg\" alt=\"PO20090304 0000\" width=\"269\" height=\"179\" /><img class=\"wp-image-253 aligncenter\" style=\"font-family: inherit;font-size: inherit\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Sementasi-Edit-300x161.jpg\" alt=\"Sementasi-Edit\" width=\"266\" height=\"143\" />\r\n\r\n<img class=\" wp-image-255 aligncenter\" src=\"https://tf.ugm.ac.id/wp-content/uploads/sites/7/2013/06/Elektrokoagulasi2-300x210.jpg\" alt=\"\" width=\"281\" height=\"197\" /></td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n&nbsp;\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t"}],"isInner":false}]}