{"version": "0.4", "title": "DTNTF Katur – Mitra (/mitra/)", "type": "container", "content": [{"id": "d7f05ccd", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 1180, "sizes": []}, "flex_direction": "column", "flex_gap": {"column": "24", "row": "24", "isLinked": true, "unit": "px", "size": 24}, "padding": {"unit": "px", "top": "60", "right": "20", "bottom": "80", "left": "20", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "48", "left": "16", "isLinked": false}}, "elements": [{"id": "d7f03dde", "elType": "container", "settings": {"content_width": "full"}, "elements": [{"id": "d7f01eef", "elType": "widget", "widgetType": "html", "settings": {"html": "<!-- =========================================================================\n     MITRA DTNTF — logo mitra, sorotan kerja sama (bento), kabar kerja sama — gaya v1.katur.online\n     Elementor > widget \"HTML\". Ganti di <div>:\n       data-base : URL folder data di GitHub Pages (berisi mitra/mitra.json, mitra/artikel.json, logo, foto)\n     Data: data/mitra/mitra.json (logo + sorotan) dan data/mitra/artikel.json (kabar; sama dengan yang dipakai halaman Pengabdian).\n     ========================================================================= -->\n\n<div class=\"dtntf-kt kt-mitra\" data-base=\"https://chilmion.github.io/dtntf-publikasi/data\">\n  <div class=\"kt-memuat\">Memuat data mitra…</div>\n</div>\n\n<style>\n.dtntf-kt{\n  --kt-navy:var(--e-global-color-870ef80,#073C64);\n  --kt-navy2:var(--e-global-color-bf890a9,#1A2C43);\n  --kt-lime:var(--e-global-color-15e26ab,#C8E86D);\n  --kt-ink:var(--e-global-color-primary,#161616);\n  --kt-text:var(--e-global-color-text,#636363);\n  --kt-abu:var(--e-global-color-1e38924,#F5F5F5);\n  --kt-line:var(--e-global-color-accent,#E3E3E3);\n  --kt-r:10px;\n  --kt-f-judul:\"Plus Jakarta Sans\",sans-serif; --kt-f-teks:\"Barlow\",sans-serif;\n  font-family:var(--kt-f-teks); font-size:16px; line-height:1.5; font-weight:400;\n  color:var(--kt-text); max-width:1180px; margin:0 auto;\n}\n.dtntf-kt *{box-sizing:border-box}\n.dtntf-kt a{color:inherit}\n.dtntf-kt .kt-memuat,.dtntf-kt .kt-galat{padding:28px;text-align:center;background:var(--kt-abu);border-radius:var(--kt-r)}\n.dtntf-kt .kt-galat{color:#8a2b2b;background:#fdf1f1}\n.dtntf-kt .kt-h2{font-family:var(--kt-f-judul);font-weight:400;font-size:40px;line-height:1.2em;letter-spacing:-1.7px;word-spacing:0;color:var(--kt-ink);margin:0 0 8px}\n.dtntf-kt .kt-lead{margin:0 0 24px;font-size:17px}\n.dtntf-kt .kt-blok{margin-top:72px}\n.dtntf-kt .kt-blok:first-child{margin-top:0}\n\n/* logo mitra: kotak sama besar, abu-abu lalu berwarna saat disorot */\n.dtntf-kt .kt-logo-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}\n.dtntf-kt .kt-logo{display:flex;align-items:center;justify-content:center;aspect-ratio:3/2;padding:22px;background:#fff;border:1px solid var(--kt-line);border-radius:var(--kt-r);text-align:center}\n.dtntf-kt .kt-logo img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;filter:grayscale(1);opacity:.72;transition:filter .25s,opacity .25s}\n.dtntf-kt .kt-logo:hover img{filter:none;opacity:1}\n.dtntf-kt .kt-logo span{font:600 16px/1.3 var(--kt-f-judul);letter-spacing:-.3px;color:var(--kt-navy)}\n\n/* sorotan: bento (foto + gradien navy + lingkaran lime) */\n.dtntf-kt .kt-sorot{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:220px;gap:16px}\n.dtntf-kt .kt-so{position:relative;overflow:hidden;border-radius:var(--kt-r);background:var(--kt-navy2);color:#fff;display:flex;flex-direction:column;justify-content:flex-end;padding:22px;grid-column:span 3}\n.dtntf-kt .kt-so.besar{grid-column:span 6;grid-row:span 2;padding:28px}\n.dtntf-kt .kt-so.l4{grid-column:span 4}\n.dtntf-kt .kt-so img.kt-so-foto{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}\n.dtntf-kt .kt-so:hover img.kt-so-foto{transform:scale(1.04)}\n.dtntf-kt .kt-so.foto::after{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,60,100,.06) 30%,rgba(7,25,50,.9) 100%)}\n.dtntf-kt .kt-so>*:not(img){position:relative;z-index:2}\n.dtntf-kt .kt-so h3{font-family:var(--kt-f-judul);font-weight:600;font-size:20px;line-height:1.2;letter-spacing:-.6px;margin:0 0 6px;color:inherit;word-spacing:0}\n.dtntf-kt .kt-so.besar h3{font-size:30px;letter-spacing:-1.1px}\n.dtntf-kt .kt-so p{margin:0;font-size:14.5px;line-height:1.4;opacity:.92;color:inherit;max-width:520px}\n.dtntf-kt .kt-so.navy{background:var(--kt-navy)}\n.dtntf-kt .kt-so.lime{background:var(--kt-lime);color:var(--kt-navy2)}\n.dtntf-kt .kt-so.putih{background:#fff;color:var(--kt-ink);border:1px solid var(--kt-line)}\n.dtntf-kt .kt-so.putih p{color:var(--kt-text)}\n.dtntf-kt .kt-so-logo{position:absolute!important;left:22px;top:20px;background:#fff;border-radius:8px;padding:8px 12px;height:44px;display:flex;align-items:center}\n.dtntf-kt .kt-so-logo img{height:100%;width:auto;display:block}\n.dtntf-kt .kt-so-panah{position:absolute!important;right:16px;top:16px;width:38px;height:38px;border-radius:50%;background:var(--kt-lime);color:var(--kt-navy2);display:flex;align-items:center;justify-content:center}\n.dtntf-kt .kt-so-panah svg{width:16px;height:16px}\n.dtntf-kt .kt-so h3 a{text-decoration:none}\n.dtntf-kt .kt-so h3 a::after{content:\"\";position:absolute;inset:0;z-index:3}\n\n/* kabar kerja sama: kartu sama besar, gaya situs FT UGM */\n.dtntf-kt .kt-kabar{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}\n.dtntf-kt .kt-kb{display:flex;flex-direction:column;background:#fff;border:1px solid var(--kt-line);border-radius:12px;overflow:hidden;text-decoration:none;color:inherit;transition:border-color .2s,box-shadow .2s}\n.dtntf-kt .kt-kb:hover{border-color:var(--kt-navy);box-shadow:0 8px 24px rgba(7,60,100,.1)}\n.dtntf-kt .kt-kb-foto{aspect-ratio:16/10;background:var(--kt-abu);overflow:hidden}\n.dtntf-kt .kt-kb-foto img{width:100%;height:100%;object-fit:cover;display:block}\n.dtntf-kt .kt-kb-isi{display:flex;flex-direction:column;gap:8px;padding:18px 20px 20px;flex:1}\n.dtntf-kt .kt-kb time{font-size:13px;color:var(--kt-text)}\n.dtntf-kt .kt-kb h3{font:500 18px/1.35 var(--kt-f-judul);letter-spacing:-.4px;color:var(--kt-ink);margin:0;word-spacing:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:calc(1.35em * 3)}\n.dtntf-kt .kt-kb .kt-baca{margin-top:auto;padding-top:6px;font:600 12px var(--kt-f-teks);letter-spacing:.8px;text-transform:uppercase;color:var(--kt-navy)}\n\n@media (max-width:1024px){\n  .dtntf-kt .kt-logo-grid{grid-template-columns:repeat(4,1fr)}\n  .dtntf-kt .kt-kabar{grid-template-columns:repeat(2,1fr)}\n  .dtntf-kt .kt-sorot{grid-template-columns:repeat(6,1fr)}\n  .dtntf-kt .kt-so,.dtntf-kt .kt-so.l4{grid-column:span 3}\n  .dtntf-kt .kt-so.besar{grid-column:1/-1;grid-row:span 2}\n}\n@media (max-width:767px){\n  .dtntf-kt .kt-h2{font-size:28px}\n  .dtntf-kt .kt-blok{margin-top:48px}\n  .dtntf-kt .kt-logo-grid{grid-template-columns:repeat(2,1fr);gap:12px}\n  .dtntf-kt .kt-logo{padding:16px}\n  .dtntf-kt .kt-sorot{grid-template-columns:1fr;grid-auto-rows:210px}\n  .dtntf-kt .kt-so,.dtntf-kt .kt-so.l4,.dtntf-kt .kt-so.besar{grid-column:1/-1;grid-row:span 1}\n  .dtntf-kt .kt-so.besar h3{font-size:24px}\n  .dtntf-kt .kt-kabar{grid-template-columns:1fr}\n}\n</style>\n\n<script>\n(function () {\n  var akar = document.currentScript.parentNode.querySelector('.kt-mitra')\n          || document.querySelector('.kt-mitra:not([data-kt-siap])');\n  if (!akar || akar.dataset.ktSiap) return;\n  akar.dataset.ktSiap = '1';\n  var BASE = (akar.getAttribute('data-base') || '').replace(/\\/$/, '');\n  var esc = function (s) {\n    return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c];\n    });\n  };\n  var ambil = function (u) {\n    return fetch(u, { cache: 'no-cache' }).then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); });\n  };\n  var BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];\n  var tgl = function (s) { var p = String(s || '').split('-'); return p.length === 3 ? (+p[2]) + ' ' + BULAN[+p[1] - 1] + ' ' + p[0] : ''; };\n  var PANAH = '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 17L17 7M8 7h9v9\"/></svg>';\n\n  Promise.all([ambil(BASE + '/mitra/mitra.json'), ambil(BASE + '/mitra/artikel.json')]).then(function (r) { render(r[0], r[1]); })\n    .catch(function (e) { akar.innerHTML = '<div class=\"kt-galat\">Data mitra belum tersedia. (' + esc(e.message) + ')</div>'; });\n\n  function render(m, a) {\n    var h = [];\n    h.push('<section class=\"kt-blok\"><h2 class=\"kt-h2\">Mitra kerja sama</h2><p class=\"kt-lead\">Industri, lembaga pemerintah, dan perguruan tinggi yang bekerja sama dengan DTNTF dalam pendidikan, penelitian, dan pengabdian.</p>' +\n      '<div class=\"kt-logo-grid\">' + (m.logo || []).map(function (l) {\n        return '<div class=\"kt-logo\" title=\"' + esc(l.nama) + '\">' + (l.gambar ? '<img src=\"' + esc(BASE + '/' + l.gambar) + '\" alt=\"' + esc(l.nama) + '\" loading=\"lazy\">' : '<span>' + esc(l.nama) + '</span>') + '</div>';\n      }).join('') + '</div></section>');\n\n    h.push('<section class=\"kt-blok\"><h2 class=\"kt-h2\">Sorotan kerja sama</h2><p class=\"kt-lead\">Kerja sama yang sedang berjalan dan hasil yang sudah terlihat.</p><div class=\"kt-sorot\">' +\n      (m.sorotan || []).map(function (s) {\n        var kelas = 'kt-so' + (s.gambar ? ' foto' : '') + (s.ukuran === 'besar' ? ' besar' : '') + (s.lebar === 4 ? ' l4' : '') + (s.warna ? ' ' + s.warna : '');\n        var judul = s.url ? '<a href=\"' + esc(s.url) + '\" target=\"_blank\" rel=\"noopener\">' + esc(s.judul) + '</a>' : esc(s.judul);\n        return '<div class=\"' + kelas + '\">' + (s.gambar ? '<img class=\"kt-so-foto\" src=\"' + esc(BASE + '/' + s.gambar) + '\" alt=\"\" loading=\"lazy\">' : '') +\n          (s.logo ? '<span class=\"kt-so-logo\"><img src=\"' + esc(BASE + '/' + s.logo) + '\" alt=\"\"></span>' : '') +\n          (s.url ? '<span class=\"kt-so-panah\" aria-hidden=\"true\">' + PANAH + '</span>' : '') +\n          '<h3>' + judul + '</h3><p>' + esc(s.ket) + '</p></div>';\n      }).join('') + '</div></section>');\n\n    h.push('<section class=\"kt-blok\"><h2 class=\"kt-h2\">Kabar kerja sama</h2><p class=\"kt-lead\">Kegiatan terbaru bersama mitra.</p><div class=\"kt-kabar\">' +\n      (a.artikel || []).map(function (x) {\n        return '<a class=\"kt-kb\" href=\"' + esc(x.url) + '\" target=\"_blank\" rel=\"noopener\"><div class=\"kt-kb-foto\"><img src=\"' + esc(BASE + '/' + x.gambar) + '\" alt=\"\" loading=\"lazy\"></div>' +\n          '<div class=\"kt-kb-isi\"><time datetime=\"' + esc(x.tanggal) + '\">' + tgl(x.tanggal) + '</time><h3>' + esc(x.judul) + '</h3><span class=\"kt-baca\">Baca selengkapnya</span></div></a>';\n      }).join('') + '</div></section>');\n    akar.innerHTML = h.join('');\n  }\n})();\n</script>\n"}, "elements": []}], "isInner": true}], "isInner": false}], "page_settings": []}