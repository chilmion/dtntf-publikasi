{"version": "0.4", "title": "DTNTF – Profil Dosen + Publikasi", "type": "container", "content": [{"id": "d7f13556", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 1080, "sizes": []}, "flex_direction": "column", "flex_gap": {"column": "44", "row": "44", "isLinked": true, "unit": "px", "size": 44}, "padding": {"unit": "px", "top": "56", "right": "20", "bottom": "64", "left": "20", "isLinked": false}}, "elements": [{"id": "d7f0d889", "elType": "container", "settings": {"content_width": "full", "flex_direction": "row", "flex_direction_mobile": "column", "flex_gap": {"column": "36", "row": "36", "isLinked": true, "unit": "px", "size": 36}, "flex_align_items": "flex-start"}, "elements": [{"id": "d7f03dde", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 28, "sizes": []}, "width_tablet": {"unit": "%", "size": 40, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "flex_direction": "column"}, "elements": [{"id": "d7f01eef", "elType": "widget", "widgetType": "image", "settings": {"image": {"url": "https://placehold.co/400x500/E8EEF4/073C64?text=Foto+Dosen", "id": ""}, "image_size": "full", "width": {"unit": "%", "size": 100, "sizes": []}, "image_border_radius": {"unit": "px", "top": "12", "right": "12", "bottom": "12", "left": "12", "isLinked": true}}, "elements": []}], "isInner": false}, {"id": "d7f0b99a", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 72, "sizes": []}, "width_tablet": {"unit": "%", "size": 60, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "flex_direction": "column", "flex_gap": {"column": "10", "row": "10", "isLinked": true, "unit": "px", "size": 10}}, "elements": [{"id": "d7f05ccd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Prof. Dr. Nama Dosen, S.T., M.Sc.", "header_size": "h1", "title_color": "#1A2C43", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "700", "typography_font_size": {"unit": "rem", "size": 2.1, "sizes": []}}, "elements": []}, {"id": "d7f07bbc", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jabatan fungsional · Program Studi Teknik Fisika", "header_size": "h3", "title_color": "#073C64", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "500", "typography_font_size": {"unit": "rem", "size": 1, "sizes": []}}, "elements": []}, {"id": "d7f09aab", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Tulis biografi singkat dosen di sini: bidang keahlian, riwayat pendidikan, dan minat riset. Bagian ini kamu desain sendiri; hanya widget publikasi di bawahnya yang terisi otomatis.</p><p>Email: nama@ugm.ac.id</p>", "text_color": "#4a5264"}, "elements": []}], "isInner": false}], "isInner": true}, {"id": "d7f11667", "elType": "container", "settings": {"content_width": "full"}, "elements": [{"id": "d7f0f778", "elType": "widget", "widgetType": "html", "settings": {"html": "<!-- =========================================================================\n     WIDGET PUBLIKASI DOSEN DTNTF\n     Tempel ke Elementor > widget \"HTML\", di BAWAH bagian profil yang\n     kamu desain sendiri.\n\n       data-base   : URL folder data di GitHub Pages\n       data-slug   : slug dosen untuk halaman ini\n       data-tampil : bagian yang ditampilkan, dipisah koma.\n                     pilihan: skor, grafik, metrik, publikasi\n\n     Konsep: statistik ditampilkan lengkap (datang dari tabel metrik SINTA,\n     jadi akurat untuk seluruh karier), sedangkan daftar publikasi hanya\n     10 terbaru per kategori — itu batas yang SINTA berikan tanpa login.\n     Tidak ada pencarian atau filter, karena menyaring 10 entri tidak ada\n     gunanya dan hanya membuat halaman terasa lebih lengkap dari kenyataan.\n\n     Warna & font: Brand Guideline DTNTF 2026.\n     ========================================================================= -->\n\n<div class=\"dtntf-pub\"\n     data-base=\"https://chilmion.github.io/dtntf-publikasi/data\"\n     data-slug=\"faridah\"\n     data-tampil=\"skor,grafik,metrik,publikasi\">\n  <div class=\"dp-loading\">Memuat data publikasi…</div>\n</div>\n\n<style>\n.dtntf-pub{\n  --dp-navy:#073C64; --dp-navy-2:#1A2C43; --dp-ink:#0B0B16;\n  --dp-ink-2:#4a5264; --dp-ink-3:#858c9c;\n  --dp-surface:#fff; --dp-surface-2:#F7F7FB; --dp-line:#e3e4ec;\n  --dp-lime:#C8E86D; --dp-navy-soft:#e8eef4;\n  --dp-scholar:#3a6b45;\n  --dp-radius:10px;\n  font-family:'Plus Jakarta Sans','Jakarta Sans',inherit,system-ui,sans-serif;\n  color:var(--dp-ink); line-height:1.55; max-width:1080px; margin:0 auto;\n}\n.dtntf-pub *{box-sizing:border-box}\n.dtntf-pub .dp-loading,.dtntf-pub .dp-error{padding:26px;text-align:center;color:var(--dp-ink-2);\n  background:var(--dp-surface-2);border-radius:var(--dp-radius)}\n.dtntf-pub .dp-error{color:#8a2b2b;background:#fdf1f1}\n\n.dtntf-pub .dp-judul{font-size:.76rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;\n  color:var(--dp-navy-2);margin:0 0 15px;padding-bottom:9px;position:relative;\n  border-bottom:1px solid var(--dp-line)}\n.dtntf-pub .dp-judul::after{content:\"\";position:absolute;left:0;bottom:-1px;width:44px;height:3px;\n  background:var(--dp-lime)}\n.dtntf-pub .dp-blok{margin-bottom:36px}\n.dtntf-pub .dp-blok:last-child{margin-bottom:0}\n\n/* ---- skor SINTA ---- */\n.dtntf-pub .dp-skor{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:11px}\n.dtntf-pub .dp-skor-item{background:var(--dp-surface-2);border-radius:var(--dp-radius);padding:16px 18px}\n.dtntf-pub .dp-skor-item.utama{background:var(--dp-navy);color:#fff}\n.dtntf-pub .dp-skor-angka{font-size:1.9rem;font-weight:700;line-height:1.1;\n  font-variant-numeric:tabular-nums;color:var(--dp-navy)}\n.dtntf-pub .dp-skor-item.utama .dp-skor-angka{color:#fff}\n.dtntf-pub .dp-skor-label{font-size:.78rem;color:var(--dp-ink-2);margin-top:4px;font-weight:500}\n.dtntf-pub .dp-skor-item.utama .dp-skor-label{color:rgba(255,255,255,.82)}\n\n/* ---- grafik ringkasan ---- */\n.dtntf-pub .dp-grafik{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}\n.dtntf-pub .dp-kartu{background:var(--dp-surface-2);border-radius:var(--dp-radius);padding:18px 20px}\n.dtntf-pub .dp-kartu.lebar{grid-column:1/-1}\n.dtntf-pub .dp-kartu-judul{font-size:.86rem;font-weight:700;color:var(--dp-navy-2);margin:0 0 12px}\n.dtntf-pub .dp-donat-baris{display:flex;align-items:center;gap:22px;flex-wrap:wrap}\n.dtntf-pub .dp-donat{width:150px;height:150px;flex:none}\n.dtntf-pub .dp-donat-total{font-size:20px;font-weight:700;fill:var(--dp-navy);font-family:inherit}\n.dtntf-pub .dp-donat-sub{font-size:7px;fill:var(--dp-ink-3);font-family:inherit}\n.dtntf-pub .dp-legenda-v{display:flex;flex-direction:column;gap:6px;font-size:.82rem;flex:1 1 130px}\n.dtntf-pub .dp-legenda-v div{display:flex;align-items:center;gap:8px}\n.dtntf-pub .dp-legenda-v b{margin-left:auto;font-variant-numeric:tabular-nums}\n.dtntf-pub .dp-radar{width:100%;max-width:340px;height:auto;display:block;margin:0 auto}\n.dtntf-pub .dp-radar-teks{font-size:10.5px;fill:var(--dp-ink-2);font-family:inherit}\n.dtntf-pub .dp-radar-nilai{font-size:10.5px;font-weight:700;fill:var(--dp-navy);font-family:inherit}\n.dtntf-pub .dp-tahun-chart{width:100%;height:120px;overflow:visible}\n.dtntf-pub .dp-tahun-bar{fill:var(--dp-navy)}\n.dtntf-pub .dp-tahun-bar:hover{opacity:.65}\n.dtntf-pub .dp-tahun-sumbu{display:flex;justify-content:space-between;font-size:.72rem;color:var(--dp-ink-3);margin-top:5px}\n\n/* ---- tabel metrik dengan bar ---- */\n.dtntf-pub .dp-legenda{display:flex;gap:18px;flex-wrap:wrap;font-size:.79rem;\n  color:var(--dp-ink-2);margin-bottom:14px}\n.dtntf-pub .dp-legenda span{display:inline-flex;align-items:center;gap:6px}\n.dtntf-pub .dp-dot{width:10px;height:10px;border-radius:2px;display:inline-block}\n.dtntf-pub .dp-dot-scopus{background:var(--dp-navy)}\n.dtntf-pub .dp-dot-scholar{background:var(--dp-scholar)}\n.dtntf-pub .dp-dot-wos{background:var(--dp-ink-3)}\n\n.dtntf-pub .dp-metrik{display:flex;flex-direction:column;gap:16px}\n.dtntf-pub .dp-baris-nama{font-size:.84rem;font-weight:600;color:var(--dp-navy-2);margin-bottom:6px}\n.dtntf-pub .dp-bar-baris{display:grid;grid-template-columns:78px 1fr 62px;gap:10px;\n  align-items:center;font-size:.78rem;margin-bottom:4px}\n.dtntf-pub .dp-bar-sumber{color:var(--dp-ink-2)}\n.dtntf-pub .dp-bar-jalur{display:block;background:var(--dp-surface-2);border-radius:4px;height:9px;overflow:hidden}\n.dtntf-pub .dp-bar-isi{display:block;height:100%;border-radius:4px;min-width:3px}\n.dtntf-pub .dp-bar-nilai{text-align:right;font-variant-numeric:tabular-nums;font-weight:600;\n  color:var(--dp-ink)}\n\n/* ---- daftar publikasi ---- */\n.dtntf-pub .dp-kat{display:flex;align-items:baseline;justify-content:space-between;gap:12px;\n  flex-wrap:wrap;margin:26px 0 10px;padding-bottom:7px;border-bottom:1px solid var(--dp-line)}\n.dtntf-pub .dp-kat:first-of-type{margin-top:0}\n.dtntf-pub .dp-kat-nama{font-size:.95rem;font-weight:700;color:var(--dp-navy-2)}\n.dtntf-pub .dp-kat-n{font-size:.75rem;color:var(--dp-ink-3)}\n.dtntf-pub .dp-pub{padding:11px 0;border-bottom:1px solid var(--dp-line)}\n.dtntf-pub .dp-pub:last-child{border-bottom:0}\n.dtntf-pub .dp-pub-judul{font-weight:600;font-size:.93rem;margin:0 0 4px;line-height:1.42}\n.dtntf-pub .dp-pub-judul a{color:var(--dp-ink);text-decoration:none}\n.dtntf-pub .dp-pub-judul a:hover{color:var(--dp-navy);text-decoration:underline}\n.dtntf-pub .dp-pub-meta{font-size:.77rem;color:var(--dp-ink-3);display:flex;gap:9px;\n  flex-wrap:wrap;align-items:center}\n.dtntf-pub .dp-tag{background:var(--dp-surface-2);border-radius:4px;padding:1px 7px}\n.dtntf-pub .dp-tag-q{background:var(--dp-navy-soft);color:var(--dp-navy);font-weight:600}\n.dtntf-pub .dp-tag-alt{background:#f1f6e2;color:#4a6115;font-weight:600}\n\n.dtntf-pub .dp-catatan{font-size:.78rem;color:var(--dp-ink-2);background:var(--dp-surface-2);\n  border-left:3px solid var(--dp-lime);border-radius:0 8px 8px 0;padding:10px 14px;margin-top:20px}\n.dtntf-pub .dp-catatan a{color:var(--dp-navy)}\n.dtntf-pub .dp-kaki{font-size:.73rem;color:var(--dp-ink-3);margin-top:20px;\n  display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}\n.dtntf-pub .dp-kaki a{color:var(--dp-navy);text-decoration:none}\n.dtntf-pub .dp-kaki a:hover{text-decoration:underline}\n\n@media (max-width:700px){ .dtntf-pub .dp-grafik{grid-template-columns:1fr} }\n@media (max-width:560px){\n  .dtntf-pub .dp-skor{grid-template-columns:repeat(2,1fr);gap:9px}\n  .dtntf-pub .dp-skor-item{padding:13px 14px}\n  .dtntf-pub .dp-skor-angka{font-size:1.5rem}\n  .dtntf-pub .dp-bar-baris{grid-template-columns:66px 1fr 54px;font-size:.74rem}\n}\n</style>\n\n<script>\n(function () {\n  var akar = document.currentScript.parentNode.querySelector('.dtntf-pub')\n          || document.querySelector('.dtntf-pub:not([data-dp-siap])');\n  if (!akar || akar.dataset.dpSiap) return;\n  akar.dataset.dpSiap = '1';\n\n  var BASE = (akar.dataset.base || '').replace(/\\/$/, '');\n  var SLUG = akar.dataset.slug || '';\n  var TAMPIL = (akar.dataset.tampil || 'skor,grafik,metrik,publikasi')\n                 .split(',').map(function (s) { return s.trim(); });\n  var mau = function (n) { return TAMPIL.indexOf(n) > -1; };\n\n  var esc = function (s) {\n    return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c];\n    });\n  };\n  var num = function (n) { return (n == null) ? '–' : Number(n).toLocaleString('id-ID'); };\n\n  var NAMA_KATEGORI = {\n    scopus: 'Publikasi terindeks Scopus',\n    garuda: 'Publikasi jurnal nasional (Garuda)',\n    ilmiah: 'Publikasi ilmiah lainnya',\n    buku: 'Buku',\n    paten: 'Paten & Hak Kekayaan Intelektual',\n    penelitian: 'Penelitian',\n    ppm: 'Pengabdian kepada Masyarakat'\n  };\n  var URUT = ['scopus', 'garuda', 'ilmiah', 'buku', 'paten', 'penelitian', 'ppm'];\n\n  // Baris tabel metrik. Tiap baris punya skalanya sendiri — membandingkan\n  // 421 artikel dengan 2.334 sitasi dalam satu skala tidak ada artinya.\n  var BARIS = [\n    ['artikel', 'Artikel'],\n    ['sitasi', 'Sitasi'],\n    ['dokumen_disitasi', 'Dokumen disitasi'],\n    ['hindex', 'H-Index'],\n    ['i10index', 'i10-Index'],\n    ['gindex', 'G-Index']\n  ];\n  var SUMBER = [\n    ['scopus', 'Scopus', 'dp-dot-scopus', 'var(--dp-navy)'],\n    ['scholar', 'GScholar', 'dp-dot-scholar', 'var(--dp-scholar)'],\n    ['wos', 'WOS', 'dp-dot-wos', 'var(--dp-ink-3)']\n  ];\n\n  fetch(BASE + '/' + encodeURIComponent(SLUG) + '.json', { cache: 'no-cache' })\n    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })\n    .then(render)\n    .catch(function (e) {\n      akar.innerHTML = '<div class=\"dp-error\">Data publikasi belum tersedia. (' + esc(e.message) + ')</div>';\n    });\n\n  function lencana(p) {\n    if (p.kuartil) return { teks: p.kuartil, kelas: 'dp-tag-q' };\n    if (p.akreditasi && !/unknown/i.test(p.akreditasi))\n      return { teks: p.akreditasi, kelas: 'dp-tag-q' };\n    if (p.jenis_paten) return { teks: p.jenis_paten, kelas: 'dp-tag-alt' };\n    if (p.dana) return { teks: p.dana, kelas: 'dp-tag-alt' };\n    if (p.isbn) return { teks: 'ISBN ' + p.isbn, kelas: '' };\n    return null;\n  }\n\n  // ---------- grafik ringkasan (dari data \"Summary\" SINTA) ----------\n  var WARNA_Q = { 'Q1': '#073C64', 'Q2': '#2E6C9A', 'Q3': '#6FA3C7', 'Q4': '#B6CFE0', 'No-Q': '#C4C8D3' };\n  var NAMA_Q = { 'No-Q': 'Tanpa kuartil' };\n  var NAMA_OUT = { 'Articles': 'Artikel jurnal', 'Conference': 'Prosiding', 'Others': 'Lainnya' };\n\n  function donat(data) {\n    var total = data.reduce(function (a, x) { return a + x.jumlah; }, 0);\n    if (!total) return '';\n    var kum = 0;\n    var arc = data.map(function (x) {\n      var p = x.jumlah / total * 100, w = WARNA_Q[x.nama] || '#8fb0c9';\n      var c = '<circle cx=\"60\" cy=\"60\" r=\"44\" fill=\"none\" stroke=\"' + w + '\" stroke-width=\"18\" ' +\n        'pathLength=\"100\" stroke-dasharray=\"' + p.toFixed(3) + ' ' + (100 - p).toFixed(3) +\n        '\" stroke-dashoffset=\"' + (-kum).toFixed(3) + '\" transform=\"rotate(-90 60 60)\">' +\n        '<title>' + esc(NAMA_Q[x.nama] || x.nama) + ' · ' + x.jumlah + '</title></circle>';\n      kum += p;\n      return c;\n    }).join('');\n    var leg = data.map(function (x) {\n      return '<div><i class=\"dp-dot\" style=\"background:' + (WARNA_Q[x.nama] || '#8fb0c9') + '\"></i>' +\n        esc(NAMA_Q[x.nama] || x.nama) + '<b>' + num(x.jumlah) + '</b></div>';\n    }).join('');\n    return '<div class=\"dp-donat-baris\"><svg class=\"dp-donat\" viewBox=\"0 0 120 120\" role=\"img\" ' +\n      'aria-label=\"Sebaran kuartil artikel Scopus\">' + arc +\n      '<text class=\"dp-donat-total\" x=\"60\" y=\"62\" text-anchor=\"middle\">' + num(total) + '</text>' +\n      '<text class=\"dp-donat-sub\" x=\"60\" y=\"73\" text-anchor=\"middle\">artikel</text></svg>' +\n      '<div class=\"dp-legenda-v\">' + leg + '</div></div>';\n  }\n\n  function radar(data) {\n    var n = data.length;\n    if (n < 3) return '';\n    var maks = Math.max.apply(null, data.map(function (x) { return x.jumlah; })) || 1;\n    var cx = 150, cy = 118, R = 78;\n    var pt = function (i, f) {\n      var a = -Math.PI / 2 + i * 2 * Math.PI / n;\n      return [cx + Math.cos(a) * R * f, cy + Math.sin(a) * R * f];\n    };\n    var cincin = [1 / 3, 2 / 3, 1].map(function (f) {\n      return '<polygon points=\"' + data.map(function (_, i) { return pt(i, f).join(','); }).join(' ') +\n        '\" fill=\"none\" stroke=\"var(--dp-line)\" stroke-width=\"1\"/>';\n    }).join('');\n    var sumbu = data.map(function (_, i) {\n      var p = pt(i, 1);\n      return '<line x1=\"' + cx + '\" y1=\"' + cy + '\" x2=\"' + p[0].toFixed(1) + '\" y2=\"' + p[1].toFixed(1) +\n        '\" stroke=\"var(--dp-line)\" stroke-width=\"1\"/>';\n    }).join('');\n    var area = '<polygon points=\"' + data.map(function (x, i) {\n      return pt(i, Math.max(x.jumlah / maks, 0.02)).map(function (v) { return v.toFixed(1); }).join(',');\n    }).join(' ') + '\" fill=\"rgba(7,60,100,.22)\" stroke=\"#073C64\" stroke-width=\"1.6\"/>';\n    var teks = data.map(function (x, i) {\n      var p = pt(i, 1.16), an = p[0] < cx - 6 ? 'end' : (p[0] > cx + 6 ? 'start' : 'middle');\n      var y = p[1] + (p[1] < cy - 6 ? -4 : (p[1] > cy + 6 ? 12 : 4));\n      return '<text class=\"dp-radar-teks\" x=\"' + p[0].toFixed(1) + '\" y=\"' + y.toFixed(1) +\n        '\" text-anchor=\"' + an + '\">' + esc(NAMA_OUT[x.nama] || x.nama) + ' · ' +\n        '<tspan class=\"dp-radar-nilai\">' + num(x.jumlah) + '</tspan></text>';\n    }).join('');\n    return '<svg class=\"dp-radar\" viewBox=\"0 0 300 235\" role=\"img\" aria-label=\"Luaran riset: ' +\n      data.map(function (x) { return esc((NAMA_OUT[x.nama] || x.nama) + ' ' + x.jumlah); }).join(', ') + '\">' +\n      cincin + sumbu + area + teks + '</svg>';\n  }\n\n  function tahunan(data) {\n    if (!data || data.length < 2) return '';\n    var n = data.length, maks = Math.max.apply(null, data.map(function (x) { return x.jumlah; })) || 1;\n    var lebar = 100 / n, pad = Math.min(lebar * 0.2, 1.2);\n    var bar = data.map(function (x, i) {\n      var t = x.jumlah / maks * 86;\n      return '<rect class=\"dp-tahun-bar\" x=\"' + (i * lebar + pad).toFixed(2) + '\" y=\"' + (94 - t).toFixed(2) +\n        '\" width=\"' + Math.max(lebar - pad * 2, 0.4).toFixed(2) + '\" height=\"' + Math.max(t, 0.6).toFixed(2) +\n        '\" rx=\"0.6\"><title>' + x.tahun + ' · ' + x.jumlah + ' artikel</title></rect>';\n    }).join('');\n    return '<svg class=\"dp-tahun-chart\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" role=\"img\" ' +\n      'aria-label=\"Artikel Scopus per tahun ' + data[0].tahun + '–' + data[n - 1].tahun + '\">' +\n      '<line x1=\"0\" y1=\"94\" x2=\"100\" y2=\"94\" stroke=\"var(--dp-line)\" vector-effect=\"non-scaling-stroke\"/>' +\n      bar + '</svg><div class=\"dp-tahun-sumbu\"><span>' + data[0].tahun + '</span><span>tertinggi ' +\n      maks + ' per tahun</span><span>' + data[n - 1].tahun + '</span></div>';\n  }\n\n  function render(d) {\n    var m = d.metrik || {}, sk = d.skor || {}, t = d.tautan || {}, h = [];\n\n    // ---------- skor SINTA ----------\n    if (mau('skor')) {\n      var skor = [];\n      if (sk.overall != null) skor.push([num(sk.overall), 'Skor SINTA keseluruhan', true]);\n      if (sk.tiga_tahun != null) skor.push([num(sk.tiga_tahun), 'Skor SINTA 3 tahun terakhir']);\n      if (sk.afiliasi != null) skor.push([num(sk.afiliasi), 'Skor afiliasi']);\n      if (sk.afiliasi_tiga_tahun != null) skor.push([num(sk.afiliasi_tiga_tahun), 'Skor afiliasi 3 tahun']);\n      if (skor.length) {\n        h.push('<div class=\"dp-blok\"><h3 class=\"dp-judul\">Skor SINTA</h3><div class=\"dp-skor\">' +\n          skor.map(function (s) {\n            return '<div class=\"dp-skor-item' + (s[2] ? ' utama' : '') + '\">' +\n              '<div class=\"dp-skor-angka\">' + s[0] + '</div>' +\n              '<div class=\"dp-skor-label\">' + s[1] + '</div></div>';\n          }).join('') + '</div></div>');\n      }\n    }\n\n    // ---------- grafik ringkasan ----------\n    if (mau('grafik') && d.grafik) {\n      var g = d.grafik, kartu = [];\n      if ((g.kuartil || []).length && donat(g.kuartil))\n        kartu.push('<div class=\"dp-kartu\"><h4 class=\"dp-kartu-judul\">Kuartil artikel Scopus</h4>' + donat(g.kuartil) + '</div>');\n      if ((g.output || []).length && radar(g.output))\n        kartu.push('<div class=\"dp-kartu\"><h4 class=\"dp-kartu-judul\">Luaran riset</h4>' + radar(g.output) + '</div>');\n      if ((g.per_tahun || []).length > 1)\n        kartu.push('<div class=\"dp-kartu lebar\"><h4 class=\"dp-kartu-judul\">Artikel Scopus per tahun</h4>' + tahunan(g.per_tahun) + '</div>');\n      if (kartu.length)\n        h.push('<div class=\"dp-blok\"><h3 class=\"dp-judul\">Ringkasan riset</h3><div class=\"dp-grafik\">' +\n          kartu.join('') + '</div></div>');\n    }\n\n    // ---------- tabel metrik ----------\n    if (mau('metrik')) {\n      var adaSumber = SUMBER.filter(function (s) { return m[s[0]] && Object.keys(m[s[0]]).length; });\n      if (adaSumber.length) {\n        h.push('<div class=\"dp-blok\"><h3 class=\"dp-judul\">Metrik sitasi</h3>' +\n          '<div class=\"dp-legenda\">' + adaSumber.map(function (s) {\n            return '<span><i class=\"dp-dot ' + s[2] + '\"></i>' + s[1] + '</span>';\n          }).join('') + '</div><div class=\"dp-metrik\">' +\n          BARIS.map(function (b) {\n            var nilai = adaSumber.map(function (s) { return (m[s[0]] || {})[b[0]]; });\n            if (!nilai.some(function (v) { return v != null; })) return '';\n            var maks = Math.max.apply(null, nilai.map(function (v) { return v || 0; })) || 1;\n            return '<div><div class=\"dp-baris-nama\">' + b[1] + '</div>' +\n              adaSumber.map(function (s, i) {\n                var v = nilai[i];\n                return '<div class=\"dp-bar-baris\"><span class=\"dp-bar-sumber\">' + s[1] + '</span>' +\n                  '<span class=\"dp-bar-jalur\"><span class=\"dp-bar-isi\" style=\"width:' +\n                  ((v || 0) / maks * 100).toFixed(1) + '%;background:' + s[3] + '\"></span></span>' +\n                  '<span class=\"dp-bar-nilai\">' + num(v) + '</span></div>';\n              }).join('') + '</div>';\n          }).join('') + '</div></div>');\n      }\n    }\n\n    // ---------- daftar publikasi terbaru ----------\n    var pub = d.publikasi || [];\n    if (mau('publikasi') && pub.length) {\n      var perSumber = {};\n      pub.forEach(function (p) { (perSumber[p.sumber] = perSumber[p.sumber] || []).push(p); });\n\n      var isi = URUT.filter(function (k) { return perSumber[k] && perSumber[k].length; })\n        .map(function (k) {\n          var daftar = perSumber[k].slice().sort(function (a, b) {\n            return (b.tahun || 0) - (a.tahun || 0) || (b.sitasi || 0) - (a.sitasi || 0);\n          });\n          return '<div class=\"dp-kat\"><span class=\"dp-kat-nama\">' + esc(NAMA_KATEGORI[k] || k) + '</span>' +\n            '<span class=\"dp-kat-n\">' + daftar.length + ' terbaru</span></div>' +\n            daftar.map(kartuPub).join('');\n        }).join('');\n\n      h.push('<div class=\"dp-blok\"><h3 class=\"dp-judul\">Luaran terbaru</h3>' + isi +\n        catatanBatas(d) + '</div>');\n    }\n\n    var tautan = [];\n    if (t.sinta) tautan.push('<a href=\"' + esc(t.sinta) + '\" target=\"_blank\" rel=\"noopener\">Profil SINTA ↗</a>');\n    if (t.scholar) tautan.push('<a href=\"' + esc(t.scholar) + '\" target=\"_blank\" rel=\"noopener\">Google Scholar ↗</a>');\n    if (t.scopus) tautan.push('<a href=\"' + esc(t.scopus) + '\" target=\"_blank\" rel=\"noopener\">Scopus ↗</a>');\n    h.push('<div class=\"dp-kaki\"><span>' + tautan.join(' · ') + '</span>' +\n      '<span>Diperbarui otomatis dari SINTA · ' + esc((d.diperbarui || '').slice(0, 10)) + '</span></div>');\n\n    akar.innerHTML = h.join('');\n  }\n\n  function kartuPub(p) {\n    var l = lencana(p);\n    return '<div class=\"dp-pub\"><p class=\"dp-pub-judul\">' +\n      (p.url ? '<a href=\"' + esc(p.url) + '\" target=\"_blank\" rel=\"noopener\">' + esc(p.judul) + '</a>'\n             : esc(p.judul)) +\n      '</p><div class=\"dp-pub-meta\">' +\n      (p.venue ? '<span>' + esc(p.venue) + '</span>' : '') +\n      (p.tahun ? '<span class=\"dp-tag\">' + p.tahun + '</span>' : '') +\n      (l ? '<span class=\"dp-tag ' + l.kelas + '\">' + esc(l.teks) + '</span>' : '') +\n      (p.urutan_penulis ? '<span>penulis ke-' + esc(p.urutan_penulis) + '</span>' : '') +\n      (p.sitasi ? '<span>' + num(p.sitasi) + ' sitasi</span>' : '') +\n      '</div></div>';\n  }\n\n  function catatanBatas(d) {\n    var b = d.batas_daftar;\n    if (!b || b.lengkap) return '';\n    var t = (d.tautan || {}).sinta;\n    return '<div class=\"dp-catatan\">Angka statistik di atas mencakup seluruh karier. ' +\n      'Daftar di bagian ini hanya memuat ' + b.per_kategori + ' luaran terbaru per kategori, ' +\n      'karena itu batas yang ditampilkan SINTA bagi pengunjung umum' +\n      (t ? ' — daftar lengkap ada di <a href=\"' + esc(t) + '\" target=\"_blank\" rel=\"noopener\">profil SINTA</a>' : '') +\n      '.</div>';\n  }\n})();\n</script>\n"}, "elements": []}], "isInner": true}], "isInner": false}], "page_settings": []}