{"version": "0.4", "title": "DTNTF – Profil Anung Muharini", "type": "container", "content": [{"id": "d7f2e668", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 1180, "sizes": []}, "flex_direction": "column", "flex_gap": {"column": "24", "row": "24", "isLinked": true, "unit": "px", "size": 24}, "padding": {"unit": "px", "top": "60", "right": "20", "bottom": "80", "left": "20", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "32", "right": "16", "bottom": "48", "left": "16", "isLinked": false}}, "elements": [{"id": "d7f2c779", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p style=\"font-size:14px;margin:0\">Beranda &rsaquo; Dosen Tetap &rsaquo; Anung Muharini</p>", "text_color": "#636363", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}, "__globals__": {"text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "d7f2a88a", "elType": "container", "settings": {"content_width": "full", "flex_direction": "row", "flex_direction_tablet": "row", "flex_direction_mobile": "column", "flex_gap": {"column": "32", "row": "32", "isLinked": true, "unit": "px", "size": 32}, "flex_align_items": "flex-start"}, "elements": [{"id": "d7f0b99a", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 28, "sizes": []}, "width_tablet": {"unit": "%", "size": 34, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "flex_direction": "column", "flex_gap": {"column": "16", "row": "16", "isLinked": true, "unit": "px", "size": 16}}, "elements": [{"id": "d7f01eef", "elType": "widget", "widgetType": "image", "settings": {"image": {"url": "https://tf.ugm.ac.id/wp-content/uploads/sites/7/2024/08/foto-Anung-Muharini-1024x1024.jpg", "id": ""}, "image_size": "full", "w