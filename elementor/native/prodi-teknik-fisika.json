g": {"unit": "px", "size": 0.8, "sizes": []}}, "elements": []}, {"id": "d7f19223", "elType": "widget", "widgetType": "heading", "settings": {"title": "144–150", "header_size": "div", "title_color": "#161616", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 44, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.2, "sizes": []}, "typography_letter_spacing": {"unit": "px", "size": -2, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 44, "sizes": []}}, "elements": []}, {"id": "d7f1b112", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>SKS, sesuai persyaratan IABEE</p>", "text_color": "#636363", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}}, "elements": []}], "isInner": false}, {"id": "d7f24bbd", "elType": "container", "settings": {"content_width": "full", "background_background": "classic", "background_color": "#073C64", "border_radius": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "flex_direction": "column", "flex_gap": {"column": "6", "row": "6", "isLinked": true, "unit": "px", "size": 6}, "width": {"unit": "%", "size": 23, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "width_tablet": {"unit": "%", "size": 48.5, "sizes": []}}, "elements": [{"id": "d7f1eef0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Pilar keilmuan", "header_size": "span", "title_color": "#FFFFFF", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "600", "typography_font_size": {"unit": "px", "size": 12, "sizes": []}, "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "px", "size": 0.8, "sizes": []}}, "elements": []}, {"id": "d7f20ddf", "elType": "widget", "widgetType": "heading", "settings": {"title": "2", "header_size": "div", "title_color": "#FFFFFF", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 64, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.2, "sizes": []}, "typography_letter_spacing": {"unit": "px", "size": -4, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 44, "sizes": []}}, "elements": []}, {"id": "d7f22cce", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Fenomena multifisika dan teknik sistem</p>", "text_color": "rgba(255,255,255,.86)", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}}, "elements": []}], "isInner": false}, {"id": "d7f2c779", "elType": "container", "settings": {"content_width": "full", "background_background": "classic", "background_color": "#F5F5F5", "border_radius": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "flex_direction": "column", "flex_gap": {"column": "6", "row": "6", "isLinked": true, "unit": "px", "size": 6}, "width": {"unit": "%", "size": 23, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}, "width_tablet": {"unit": "%", "size": 48.5, "sizes": []}}, "elements": [{"id": "d7f26aac", "elType": "widget", "widgetType": "heading", "settings": {"title": "Bidang teknologi", "header_size": "span", "title_color": "#073C64", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "600", "typography_font_size": {"unit": "px", "size": 12, "sizes": []}, "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "px", "size": 0.8, "sizes": []}}, "elements": []}, {"id": "d7f2899b", "elType": "widget", "widgetType": "heading", "settings": {"title": "4", "header_size": "div", "title_color": "#161616", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 64, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.2, "sizes": []}, "typography_letter_spacing": {"unit": "px", "size": -4, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 44, "sizes": []}}, "elements": []}, {"id": "d7f2a88a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Instrumentasi &amp; kontrol, lingkungan terbangun &amp; sistem energi, material, energi terbarukan</p>", "text_color": "#636363", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}}, "elements": []}], "isInner": false}], "isInner": false}, {"id": "d7f30557", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pilar pertama, fenomena multifisika, membekali lulusan dengan kemampuan untuk menganalisis dan merekayasa sistem di mana berbagai domain fisika, seperti mekanika, termodinamika, optika, akustika, dan elektromagnetika berinteraksi secara simultan. Hal tersebut adalah kunci untuk inovasi. Oleh karena itu, program ini harus mempersiapkan lulusan untuk terlibat langsung dalam pengembangan teknologi terdepan (forefront of technology), seperti pada bidang instrumentasi &amp; kontrol, lingkungan terbangun dan sistem energi, desain dan pemrosesan material, serta energi terbarukan seperti yang dicantumkan dalam Discipline Criteria for Engineering Physics dari IABEE.</p><p>Pilar kedua, teknik sistem, melatih lulusan untuk mengatasi permasalahan rekayasa yang kompleks dengan pendekatan yang terstruktur dan sistemik. Proses ini mencakup seluruh siklus rekayasa: mulai dari pemodelan, simulasi, perancangan sistem kendali, hingga pengembangan antarmuka pengguna. Untuk memastikan keberhasilan di dunia profesional, kurikulum harus menyediakan fondasi yang kuat dalam matematika, fisika, ilmu rekayasa, dan desain keteknikan. Kurikulum juga wajib mencakup kemampuan untuk berkembang di sektor industri, seperti ekonomi rekayasa, manajemen proyek, serta kompetensi inti lainnya yang relevan dengan perkembangan teknologi. Kombinasi dari dua pilar inilah yang menjadikan lulusan Teknik Fisika sebagai pemecah masalah yang andal dan adaptif di berbagai sektor industri.</p>", "text_color": "#636363", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}, "__globals__": {"text_color": "globals/colors?id=text"}, "text_columns": "2", "text_columns_mobile": "1", "column_gap": {"unit": "px", "size": 40, "sizes": []}}, "elements": []}, {"id": "d7f3a002", "elType": "container", "settings": {"content_width": "full", "background_background": "classic", "background_color": "#C8E86D", "border_radius": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}, "padding": {"unit": "px", "top": "24", "right": "24", "bottom": "24", "left": "24", "isLinked": true}, "flex_direction": "column", "flex_gap": {"column": "8", "row": "8", "isLinked": true, "unit": "px", "size": 8}}, "elements": [{"id": "d7f32446", "elType": "widget", "widgetType": "heading", "settings": {"title": "Visi dan Misi Keilmuan", "header_size": "span", "title_color": "#1A2C43", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "600", "typography_font_size": {"unit": "px", "size": 12, "sizes": []}, "typography_text_transform": "uppercase", "typography_letter_spacing": {"unit": "px", "size": 0.8, "sizes": []}}, "elements": []}, {"id": "d7f34335", "elType": "widget", "widgetType": "heading", "settings": {"title": "Penerapan ilmu fisika dasar, matematika, dan teknologi rekayasa (engineering) untuk mengembangkan teknologi sistem multifisika (instrumentasi, sistem energi, fisika bangunan, dan material).", "header_size": "h3", "title_color": "#1A2C43", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 28, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 18, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.2, "sizes": []}, "typography_letter_spacing": {"unit": "px", "size": -1.3, "sizes": []}}, "elements": []}, {"id": "d7f36224", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p style='margin:0 0 12px'><strong>Misi Keilmuan Program Studi</strong></p>", "text_color": "#1A2C43", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}}, "elements": []}, {"id": "d7f38113", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul style='margin:0 0 14px;padding-left:22px'><li style='margin:4px 0'>Menyelenggarakan pendidikan bagi, penelitian untuk, dan pengabdian kepada masyarakat dalam bidang Teknik Fisika.</li><li style='margin:4px 0'>Menumbuhkan suasana akademik yang menggairahkan iklim belajar dan mengembangkan ilmu pengetahuan dan teknologi bidang Teknik Fisika.</li><li style='margin:4px 0'>Menjalin kerjasama dengan masyarakat pengguna dalam bidang pendidikan, penelitian dan pengabdian kepada masyarakat.</li></ul>", "text_color": "#1A2C43", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}}, "elements": []}], "isInner": false}, {"id": "d7f8188d", "elType": "container", "settings": {"content_width": "full", "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#E3E3E3", "border_radius": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}, "padding": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "_title": "Bagian akordeon"}, "elements": [{"id": "d7f7f99e", "elType": "widget", "widgetType": "nested-accordion", "settings": {"items": [{"item_title": "Kurikulum", "_id": "d7f3bef", "element_css_id": ""}, {"item_title": "Statistik Mahasiswa dan Alumni", "_id": "d7f5ade", "element_css_id": ""}, {"item_title": "Student Final Project", "_id": "d7f60aa", "element_css_id": ""}, {"item_title": "Laporan Kinerja Akademik", "_id": "d7f6677", "element_css_id": ""}], "title_tag": "h3", "default_state": "all_collapsed", "max_items_expended": "one", "accordion_item_title_icon": {"value": "fas fa-plus", "library": "fa-solid"}, "accordion_item_title_icon_active": {"value": "fas fa-minus", "library": "fa-solid"}, "accordion_item_title_icon_position": "end", "title_typography_typography": "custom", "title_typography_font_family": "Plus Jakarta Sans", "title_typography_font_weight": "400", "title_typography_font_size": {"unit": "px", "size": 26, "sizes": []}, "title_typography_letter_spacing": {"unit": "px", "size": -1.3, "sizes": []}, "normal_title_color": "#161616", "hover_title_color": "#073C64", "active_title_color": "#073C64", "_title": "Akordeon"}, "elements": [{"id": "d7f58ef2", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "flex_gap": {"column": "14", "row": "14", "isLinked": true, "unit": "px", "size": 14}, "padding": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "_title": "Kurikulum"}, "elements": [{"id": "d7f3dde0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Struktur keilmuan kurikulum Teknik Fisika digambarkan sebagai pohon: akar ilmu dasar, batang dasar keteknikan, dua cabang (teknologi proses dan integrasi sistem), dan buah berupa perancangan sistem teknik fisika.</p>", "text_color": "#636363", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}}, "elements": []}, {"id": "d7f3fccf", "elType": "widget", "widgetType": "image", "settings": {"image": {"url": "https://tf.ugm.ac.id/wp-content/uploads/sites/7/2026/11/dtntf-tf-pohon-kurikulum.png", "id": "", "alt": "Pohon kurikulum Teknik Fisika"}, "image_size": "full", "width": {"unit": "%", "size": 100, "sizes": []}, "image_border_radius": {"unit": "px", "top": "10", "right": "10", "bottom": "10", "left": "10", "isLinked": true}, "_title": "Gambar: Pohon kurikulum Teknik Fisika"}, "elements": []}, {"id": "d7f41bbe", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Komposisi beban studi (144–150 SKS) dan kesesuaiannya dengan persyaratan IABEE:</p>", "text_color": "#636363", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 17, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}}, "elements": []}, {"id": "d7f43aad", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<table style=\"width:100%;border-collapse:collapse;font-size:16px\"><thead><tr><th style=\"text-align:left;padding:10px 12px;border-bottom:2px solid #073C64;color:#073C64\">Kategori</th><th style=\"text-align:left;padding:10px 12px;border-bottom:2px solid #073C64;color:#073C64\">SKS</th><th style=\"text-align:left;padding:10px 12px;border-bottom:2px solid #073C64;color:#073C64\">Persentase</th><th style=\"text-align:left;padding:10px 12px;border-bottom:2px solid #073C64;color:#073C64\">Syarat IABEE</th></tr></thead><tbody><tr><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">Matematika &amp; Ilmu Dasar</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">30</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">20,83%</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">Min. 20%</td></tr><tr><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">Topik Keteknikan</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">61</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">42,36%</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">Min. 40%</td></tr><tr><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">Pendidikan Umum</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">23</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">15,97%</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">Max. 30%</td></tr><tr><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">Pilihan Prodi</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">12–18</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">Max 12,50%</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\"></td></tr><tr><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">Pilihan Prodi/luar Prodi/Program Lain</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">18</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\">12,50%</td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\"></td></tr><tr><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\"><strong>Total</strong></td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\"><strong>144–150</strong></td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\"><strong>100%</strong></td><td style=\"padding:10px 12px;border-bottom:1px solid #E3E3E3\"></td></tr></tbody></table>", "text_color": "#161616", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}}, "elements": []}, {"id": "d7f57003", "elType": "container", "settings": {"content_width": "full", "flex_direction": "row", "flex_wrap": "wrap", "flex_gap": {"column": "20", "row": "20", "isLinked": true, "unit": "px", "size": 20}, "flex_direction_mobile": "column", "_title": "Dokumen"}, "elements": [{"id": "d7f55114", "elType": "container", "settings": {"content_width": "full", "flex_direction": "row", "flex_direction_mobile": "column", "flex_gap": {"column": "18", "row": "18", "isLinked": true, "unit": "px", "size": 18}, "flex_align_items": "center", "width": {"unit": "%", "size": 48, "sizes": []}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "background_background": "classic", "background_color": "#FFFFFF", "border_border": "solid", "border_width": {"unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true}, "border_color": "#E3E3E3", "border_radius": {"unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true}, "padding": {"unit": "px", "top": "18", "right": "18", "bottom": "18", "left": "18", "isLinked": true}, "_title": "Kartu dokumen: Dokumen Kurikulum Teknik Fisika"}, "elements": [{"id": "d7f4b669", "elType": "container", "settings":