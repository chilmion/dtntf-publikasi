ext_transform": "uppercase", "typography_letter_spacing": {"unit": "px", "size": 0.8, "sizes": []}}, "elements": []}, {"id": "d7f03dde", "elType": "widget", "widgetType": "heading", "settings": {"title": "Mengenal Program Sarjana Teknik Fisika UGM", "header_size": "h2", "title_color": "#FFFFFF", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 52, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.2, "sizes": []}, "typography_letter_spacing": {"unit": "px", "size": -3, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 30, "sizes": []}}, "elements": []}, {"id": "d7f05ccd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Fundamental Teknik Fisika terletak pada perannya sebagai jembatan esensial antara sains dasar (fisika) dan beragam aplikasi rekayasa yang secara kokoh membentuk ciri khasnya sebagai bidang General Engineering. Disiplin ini secara sadar tidak mengkotak-kotakkan keilmuan; sebaliknya, disiplin tersebut bertujuan mencetak insinyur yang memiliki kemampuan analisis fundamental yang tajam dengan cakupan keahlian yang sangat luas. Lulusan Program Sarjana Program Studi Teknik Fisika dibekali kerangka berpikir yang integral, berbasis pada dua pilar utama: fenomena multifisika dan teknik sistem.</p>", "text_color": "rgba(255,255,255,.88)", "typography_typography": "custom", "typography_font_family": "Barlow", "typography_font_weight": "400", "typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "typography_line_height": {"unit": "em", "size": 1.5, "sizes": []}}, "elements": []}], "isInner": false}, {"id": "d7f0b99a", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 45, "sizes": []}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}}, "elements": [{"id": "d7f09aab", "elType": "widget", "widgetType": "image", "settings": {"image": {"ur