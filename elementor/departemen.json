{"version": "0.4", "title": "DTNTF – Halaman Publikasi Departemen", "type": "container", "content": [{"id": "d7f1d001", "elType": "container", "settings": {"content_width": "boxed", "boxed_width": {"unit": "px", "size": 1140, "sizes": []}, "flex_direction": "column", "flex_gap": {"column": "24", "row": "24", "isLinked": true, "unit": "px", "size": 24}, "padding": {"unit": "px", "top": "56", "right": "20", "bottom": "64", "left": "20", "isLinked": false}}, "elements": [{"id": "d7f15445", "elType": "widget", "widgetType": "heading", "settings": {"title": "Publikasi & Pengabdian Departemen", "header_size": "h1", "title_color": "#1A2C43", "typography_typography": "custom", "typography_font_family": "Plus Jakarta Sans", "typography_font_weight": "700", "typography_font_size": {"unit": "rem", "size": 2.1, "sizes": []}}, "elements": []}, {"id": "d7f17334", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Luaran dosen Departemen Teknik Nuklir dan Teknik Fisika UGM. Data diperbarui otomatis dari SINTA.</p>", "text_color": "#4a5264"}, "elements": []}, {"id": "d7f1b112", "elType": "container", "settings": {"content_width": "full"}, "elements": [{"id": "d7f19223", "elType": "widget", "widgetType": "html", "settings": {"html": "<!-- =========================================================================\n     WIDGET PUBLIKASI & PPM DEPARTEMEN — halaman /publikasi/\n     Tempel ke Elementor > widget \"HTML\".\n\n       data-base   : URL folder data di GitHub Pages\n       data-profil : pola URL halaman profil dosen; {slug} diganti otomatis.\n                     kosongkan kalau nama dosen tidak perlu jadi tautan.\n\n     Konsep sama dengan widget profil dosen: statistik yang ditampilkan hanya\n     yang akurat (jumlah dosen, sitasi & h-index dari tabel metrik SINTA tiap\n     dosen), lalu daftar luaran terbaru per tahun. Tanpa pencarian dan filter,\n     karena SINTA hanya memberi 10 entri terbaru per kategori tanpa login.\n     Angka turunan dari daftar itu (tren tahunan, komposisi) sengaja tidak\n     ditampilkan karena bias ke tahun terbaru.\n     ========================================================================= -->\n\n<div class=\"dtntf-dep\"\n     data-base=\"https://chilmion.github.io/dtntf-publikasi/data\"\n     data-profil=\"/dosen/{slug}/\">\n  <div class=\"dd-loading\">Memuat data publikasi departemen…</div>\n</div>\n\n<style>\n.dtntf-dep{\n  --dd-navy:#073C64; --dd-navy-2:#1A2C43; --dd-ink:#0B0B16;\n  --dd-ink-2:#4a5264; --dd-ink-3:#858c9c;\n  --dd-surface:#fff; --dd-surface-2:#F7F7FB; --dd-line:#e3e4ec;\n  --dd-lime:#C8E86D; --dd-navy-soft:#e8eef4; --dd-radius:10px;\n  font-family:'Plus Jakarta Sans','Jakarta Sans',inherit,system-ui,sans-serif;\n  color:var(--dd-ink); line-height:1.55; max-width:1140px; margin:0 auto;\n}\n.dtntf-dep *{box-sizing:border-box}\n.dtntf-dep .dd-loading,.dtntf-dep .dd-error{padding:28px;text-align:center;color:var(--dd-ink-2);\n  background:var(--dd-surface-2);border-radius:var(--dd-radius)}\n.dtntf-dep .dd-error{color:#8a2b2b;background:#fdf1f1}\n\n.dtntf-dep .dd-judul{font-size:.76rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;\n  color:var(--dd-navy-2);margin:0 0 15px;padding-bottom:9px;position:relative;border-bottom:1px solid var(--dd-line)}\n.dtntf-dep .dd-judul::after{content:\"\";position:absolute;left:0;bottom:-1px;width:44px;height:3px;background:var(--dd-lime)}\n.dtntf-dep .dd-blok{margin-bottom:36px}\n\n/* statistik */\n.dtntf-dep .dd-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(134px,1fr));gap:11px}\n.dtntf-dep .dd-stat{background:var(--dd-surface-2);border-radius:var(--dd-radius);padding:16px 18px}\n.dtntf-dep .dd-stat-angka{font-size:1.85rem;font-weight:700;line-height:1.1;\n  font-variant-numeric:tabular-nums;color:var(--dd-navy)}\n.dtntf-dep .dd-stat-label{font-size:.77rem;color:var(--dd-ink-2);margin-top:4px;font-weight:500}\n\n/* daftar dosen */\n.dtntf-dep .dd-dosen{display:flex;flex-direction:column}\n.dtntf-dep .dd-dosen-baris{display:grid;grid-template-columns:1fr repeat(3,84px);gap:10px;align-items:baseline;\n  padding:10px 0;border-bottom:1px solid var(--dd-line);font-size:.88rem}\n.dtntf-dep .dd-dosen-kepala{white-space:nowrap;font-size:.72rem;font-weight:600;color:var(--dd-ink-3);padding-top:0}\n.dtntf-dep .dd-dosen-baris span:not(:first-child){text-align:right;font-variant-numeric:tabular-nums}\n.dtntf-dep .dd-dosen-nama{font-weight:600;color:var(--dd-navy-2)}\n.dtntf-dep .dd-dosen-nama a{color:inherit;text-decoration:none}\n.dtntf-dep .dd-dosen-nama a:hover{text-decoration:underline}\n\n/* daftar per tahun */\n.dtntf-dep .dd-tahun{margin-bottom:30px}\n.dtntf-dep .dd-tahun-kepala{display:flex;align-items:baseline;gap:12px;margin-bottom:4px;\n  padding-bottom:8px;border-bottom:2px solid var(--dd-navy)}\n.dtntf-dep .dd-tahun-angka{font-size:1.45rem;font-weight:700;color:var(--dd-navy);line-height:1.2}\n.dtntf-dep .dd-tahun-n{font-size:.78rem;color:var(--dd-ink-3)}\n.dtntf-dep .dd-kat{font-size:.75rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;\n  color:var(--dd-ink-2);margin:20px 0 8px}\n.dtntf-dep .dd-entri{padding:9px 0 9px 14px;border-left:2px solid var(--dd-line);margin-bottom:2px;font-size:.89rem;line-height:1.5}\n.dtntf-dep .dd-entri:hover{border-left-color:var(--dd-lime);background:var(--dd-surface-2)}\n.dtntf-dep .dd-nama{font-weight:600;color:var(--dd-navy-2)}\n.dtntf-dep .dd-nama a{color:inherit;text-decoration:none}\n.dtntf-dep .dd-nama a:hover{text-decoration:underline}\n.dtntf-dep .dd-entri-judul{color:var(--dd-ink)}\n.dtntf-dep .dd-entri-judul a{color:inherit;text-decoration:none}\n.dtntf-dep .dd-entri-judul a:hover{color:var(--dd-navy);text-decoration:underline}\n.dtntf-dep .dd-entri-venue{font-style:italic;color:var(--dd-ink-2)}\n.dtntf-dep .dd-meta{font-size:.76rem;color:var(--dd-ink-3);margin-top:3px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}\n.dtntf-dep .dd-tag{background:var(--dd-surface-2);border-radius:4px;padding:1px 7px}\n.dtntf-dep .dd-tag-q{background:var(--dd-navy-soft);color:var(--dd-navy);font-weight:600}\n.dtntf-dep .dd-tag-alt{background:#f1f6e2;color:#4a6115;font-weight:600}\n\n.dtntf-dep .dd-kaki{font-size:.73rem;color:var(--dd-ink-3);margin-top:24px;text-align:right}\n.dtntf-dep .dd-catatan{font-size:.78rem;color:var(--dd-ink-2);background:var(--dd-surface-2);\n  border-left:3px solid var(--dd-lime);border-radius:0 8px 8px 0;padding:10px 14px;margin:16px 0}\n.dtntf-dep .dd-catatan a{color:var(--dd-navy)}\n\n@media (max-width:600px){\n  .dtntf-dep .dd-stat-angka{font-size:1.45rem}\n  .dtntf-dep .dd-stats{grid-template-columns:repeat(2,1fr)}\n  .dtntf-dep .dd-stat:first-child{grid-column:1/-1}\n  .dtntf-dep .dd-dosen-baris{grid-template-columns:1fr 56px 46px 58px;gap:6px;font-size:.8rem}\n}\n</style>\n\n<script>\n(function () {\n  var akar = document.currentScript.parentNode.querySelector('.dtntf-dep')\n          || document.querySelector('.dtntf-dep:not([data-dd-siap])');\n  if (!akar || akar.dataset.ddSiap) return;\n  akar.dataset.ddSiap = '1';\n\n  var BASE = (akar.dataset.base || '').replace(/\\/$/, '');\n  var POLA = akar.dataset.profil || '';\n\n  var esc = function (s) {\n    return String(s == null ? '' : s).replace(/[&<>\"']/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c];\n    });\n  };\n  var num = function (n) { return (n == null) ? '–' : Number(n).toLocaleString('id-ID'); };\n  var tautanDosen = function (x) {\n    return POLA ? '<a href=\"' + esc(POLA.replace('{slug}', x.slug)) + '\">' + esc(x.nama) + '</a>' : esc(x.nama);\n  };\n\n  fetch(BASE + '/agregat/ringkas.json', { cache: 'no-cache' })\n    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })\n    .then(function (d) {\n      // Berkas per tahun kecil; unduh semuanya sekaligus.\n      return Promise.all(d.per_tahun.map(function (t) {\n        return fetch(BASE + '/agregat/' + t.berkas + '.json', { cache: 'no-cache' })\n          .then(function (r) { return r.ok ? r.json() : { entri: [] }; })\n          .then(function (x) { return { tahun: t.tahun, entri: x.entri || [] }; });\n      })).then(function (tahun) { render(d, tahun); });\n    })\n    .catch(function (e) {\n      akar.innerHTML = '<div class=\"dd-error\">Data publikasi belum tersedia. (' + esc(e.message) + ')</div>';\n    });\n\n  function lencana(p) {\n    if (p.kuartil) return { teks: p.kuartil, kelas: 'dd-tag-q' };\n    if (p.akreditasi && !/unknown/i.test(p.akreditasi))\n      return { teks: p.akreditasi, kelas: 'dd-tag-q' };\n    if (p.jenis_paten) return { teks: p.jenis_paten, kelas: 'dd-tag-alt' };\n    if (p.dana) return { teks: p.dana, kelas: 'dd-tag-alt' };\n    if (p.isbn) return { teks: 'ISBN ' + p.isbn, kelas: '' };\n    return null;\n  }\n\n  function entriHTML(e) {\n    var l = lencana(e);\n    var judul = e.url\n      ? '<a href=\"' + esc(e.url) + '\" target=\"_blank\" rel=\"noopener\">' + esc(e.judul) + '</a>'\n      : esc(e.judul);\n    return '<div class=\"dd-entri\"><span class=\"dd-nama\">' + e.dosen.map(tautanDosen).join(', ') + '</span>. ' +\n      '<span class=\"dd-entri-judul\">\"' + judul + '\"</span>' +\n      (e.venue ? ' <span class=\"dd-entri-venue\">' + esc(e.venue) + '</span>' : '') +\n      (e.tahun ? ', ' + e.tahun : '') + '.' +\n      '<div class=\"dd-meta\">' +\n      (l ? '<span class=\"dd-tag ' + l.kelas + '\">' + esc(l.teks) + '</span>' : '') +\n      (e.sitasi ? '<span>' + num(e.sitasi) + ' sitasi</span>' : '') +\n      (e.dosen.length > 1 ? '<span>' + e.dosen.length + ' dosen DTNTF</span>' : '') +\n      '</div></div>';\n  }\n\n  function render(d, tahun) {\n    var dosen = d.dosen || [], h = [];\n    var jumlah = function (k) {\n      return dosen.reduce(function (a, x) { return a + (x[k] || 0); }, 0);\n    };\n    var hMaks = dosen.reduce(function (a, x) { return Math.max(a, x.hindex_scopus || 0); }, 0);\n\n    // Semua angka di sini datang dari metrik SINTA tiap dosen (seumur karier),\n    // bukan dari daftar 10 entri, jadi aman ditampilkan.\n    h.push('<div class=\"dd-blok\"><h3 class=\"dd-judul\">Rekam jejak departemen</h3><div class=\"dd-stats\">' +\n      [[num(d.jumlah_dosen != null ? d.jumlah_dosen : dosen.length), 'Dosen'],\n       [num(jumlah('sitasi_scopus')), 'Sitasi Scopus (jumlah profil dosen)'],\n       [num(hMaks), 'h-index Scopus tertinggi']].map(function (k) {\n        return '<div class=\"dd-stat\"><div class=\"dd-stat-angka\">' + k[0] + '</div>' +\n               '<div class=\"dd-stat-label\">' + k[1] + '</div></div>';\n      }).join('') + '</div></div>');\n\n    if (dosen.length) {\n      var urut = dosen.slice().sort(function (a, b) { return (b.skor_sinta || 0) - (a.skor_sinta || 0); });\n      h.push('<div class=\"dd-blok\"><h3 class=\"dd-judul\">Dosen</h3><div class=\"dd-dosen\">' +\n        '<div class=\"dd-dosen-baris dd-dosen-kepala\"><span>Nama</span><span>Skor</span>' +\n        '<span>Sitasi</span><span>h-index</span></div>' +\n        urut.map(function (x) {\n          return '<div class=\"dd-dosen-baris\"><span class=\"dd-dosen-nama\">' + tautanDosen(x) + '</span>' +\n            '<span>' + num(x.skor_sinta) + '</span><span>' + num(x.sitasi_scopus) + '</span>' +\n            '<span>' + num(x.hindex_scopus) + '</span></div>';\n        }).join('') + '</div></div>');\n    }\n\n    var blok = tahun.filter(function (t) { return t.entri.length; }).map(function (t) {\n      var perKat = {}, urutKat = [];\n      t.entri.forEach(function (e) {\n        if (!perKat[e.kategori]) { perKat[e.kategori] = []; urutKat.push(e.kategori); }\n        perKat[e.kategori].push(e);\n      });\n      return '<div class=\"dd-tahun\"><div class=\"dd-tahun-kepala\">' +\n        '<span class=\"dd-tahun-angka\">' + (t.tahun || 'Tanpa tahun') + '</span>' +\n        '<span class=\"dd-tahun-n\">' + t.entri.length + ' luaran</span></div>' +\n        urutKat.map(function (k) {\n          return '<div class=\"dd-kat\">' + esc(k) + '</div>' + perKat[k].map(entriHTML).join('');\n        }).join('') + '</div>';\n    }).join('');\n\n    h.push('<div class=\"dd-blok\"><h3 class=\"dd-judul\">Luaran terbaru per tahun</h3>' +\n      '<div class=\"dd-catatan\">Angka statistik di atas mencakup seluruh karier. Daftar di bawah diambil ' +\n      'otomatis dari profil SINTA tiap dosen, yang hanya menampilkan 10 entri terbaru per kategori ' +\n      'bagi pengunjung umum, sehingga karya lama belum seluruhnya tercakup. Entri jurnal nasional ' +\n      'berasal dari indeks Garuda yang dicocokkan SINTA berdasarkan nama penulis.</div>' +\n      (blok || '<p style=\"color:var(--dd-ink-2)\">Belum ada luaran.</p>') + '</div>');\n\n    h.push('<div class=\"dd-kaki\">Diperbarui otomatis dari SINTA · ' + esc(d.diperbarui || '') + '</div>');\n    akar.innerHTML = h.join('');\n  }\n})();\n</script>\n"}, "elements": []}], "isInner": true}], "isInner": false}], "page_settings": []}